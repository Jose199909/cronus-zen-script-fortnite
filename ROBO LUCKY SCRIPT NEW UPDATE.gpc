main {
if(Display){cls_oled(OLED_BLACK);
print(30,10,OLED_FONT_LARGE,OLED_WHITE,T1[0]); 
print(25,35,OLED_FONT_SMALL,OLED_WHITE,T2[0]) }
if(DeadZone){if(abs(get_val(XB1_LY)) < 0 && abs(get_val(XB1_LX)) < 0 ){ set_val(XB1_LY, 0); set_val(XB1_LX, 0); } if (abs(get_val(XB1_RX)) < 0 && abs(get_val(XB1_RY)) < 0 ){ set_val(XB1_RY, 0); set_val(XB1_RX, 0); }}
if(HairTriggers){if(get_ival(PS4_UP)){set_val(PS4_UP, 100)}if(get_ival(PS4_DOWN)){set_val(PS4_DOWN, 100)}if(get_ival(PS4_LEFT)){set_val(PS4_LEFT, 100)}if(get_ival(PS4_RIGHT)){set_val(PS4_RIGHT, 100)}if(get_ival(PS4_SQUARE)){set_val(PS4_SQUARE, 100)}if(get_ival(PS4_TRIANGLE)){set_val(PS4_TRIANGLE, 100)}if(get_ival(PS4_CIRCLE)){set_val(PS4_CIRCLE, 100)}if(get_ival(PS4_CROSS)){set_val(PS4_CROSS, 100)}if(get_ival(PS4_L1)){set_val(PS4_L1, 100)}if(get_ival(PS4_R1)){set_val(PS4_R1, 100)}if(get_ival(PS4_L2)){set_val(PS4_L2, 100)}if(get_ival(PS4_R2)){set_val(PS4_R2, 100)}if(get_ival(PS4_L3)){set_val(PS4_L3, 100)}if(get_ival(PS4_R3)){set_val(PS4_R3, 100)}if(!get_ival(PS4_L2)){if(get_ival(PS4_SHARE)){set_val(PS4_SHARE, 100)}if(get_ival(PS4_TOUCH)){set_val(PS4_TOUCH, 100)}if(get_ival(PS4_OPTIONS)){set_val(PS4_OPTIONS, 100)}}if(!get_ival(PS4_TOUCH)){if(get_ival(PS4_PS)){set_val(PS4_PS, 100)}}else {if(event_release(PS4_UP)){set_val(PS4_UP, 0)}if(event_release(PS4_DOWN)){set_val(PS4_DOWN, 0)}if(event_release(PS4_LEFT)){set_val(PS4_LEFT, 0)}if(event_release(PS4_RIGHT)){set_val(PS4_RIGHT, 0)}if(event_release(PS4_SQUARE)){set_val(PS4_SQUARE, 0)}if(event_release(PS4_TRIANGLE)){set_val(PS4_TRIANGLE, 0)}if(event_release(PS4_CIRCLE)){set_val(PS4_CIRCLE, 0)}if(event_release(PS4_CROSS)){set_val(PS4_CROSS, 0)}if(event_release(PS4_L1)){set_val(PS4_L1, 0)}if(event_release(PS4_R1)){set_val(PS4_R1, 0)}if(event_release(PS4_L2)){set_val(PS4_L2, 0)}if(event_release(PS4_R2)){set_val(PS4_R2, 0)}if(event_release(PS4_L3)){set_val(PS4_L3, 0)}if(event_release(PS4_R3)){set_val(PS4_R3, 0)}if(event_release(PS4_SHARE)){set_val(PS4_SHARE, 0)}if(event_release(PS4_TOUCH)){set_val(PS4_TOUCH, 0)}if(event_release(PS4_OPTIONS)){set_val(PS4_OPTIONS, 0)}if(event_release(PS4_PS)){set_val(PS4_PS, 0)}}if(get_ival(XB1_LT) > 1)set_val(XB1_LT, 100);if(get_ival(XB1_RT) > 1)set_val(XB1_RT, 100)}
if(LessInputDelay){vm_tctrl(-6)}
if(PS4Controller && get_console() == PIO_XB360 && get_controller() == PIO_PS4)  swap(PS4_TOUCH,PS4_SHARE);
if(AutoConfirmMacro){if(event_press(FastReset)){combo_run(AutoConfirmMacro);}}
if(InstaEditReset){ if (EditHold) {if (get_ival(Edit) && get_ptime(Edit) > 0) {Edit1 = TRUE;Edit2 = TRUE;}}else if (event_press(Edit)) {Edit1 = TRUE;Edit2 = TRUE;}if (Edit2) {if (event_release(Select)) {  Edit1 = FALSE;Edit2 = FALSE;}}if (Edit1 || Edit2) if (event_press(Reset)) {  combo_run(InstaEditReset)Edit1 = FALSE;Edit2 = FALSE;}}
if(Editassist) {if (get_ival(EditAssist)) {EditAssist();Edit1 = TRUE;}if (event_release(EditAssist)) {EditT = 0;	Edit1 = FALSE;}}
if(BuildTracker) { if(event_press(Build)) { BuildTrack = BuildTrack;} if(BuildTrack) { BuildCount += get_rtime(); if(event_press(Pickaxe) || BuildCount == BuildSyncTime) { BuildTrack = FALSE; BuildCount = 0;}  if(get_ival(PS4_L1) || get_ival(PS4_L2) || get_ival(PS4_R2) || get_ival(PS4_R1) || get_ival(PS4_SQUARE)) BuildCount = 0;   }}if(!BuildTrack) {
if(AimBot){combo_run(AimBot1)if(abs(get_val(PS4_RX)) >= 19 || abs(get_val(PS4_RY)) >= 19 || abs(get_val(PS4_LX)) > 15 || abs(get_val(PS4_LY)) > 15)if(PS4_RX + PS4_RY > 0)combo_stop(AimBot1)combo_run(AimBot3)if(abs(get_val(PS4_RX)) > 15 || abs(get_val(PS4_RY)) > 15)combo_stop(AimBot3)combo_run(AimBot4)if(abs(get_val(PS4_RX)) > 16 || abs(get_val(PS4_RY)) > 16)combo_stop(AimBot4)combo_run(AimBot5)if(abs(get_val(PS4_RX)) > 17 || abs(get_val(PS4_RY)) > 17)combo_stop(AimBot5)}
if(LongRangeAA){if(get_ival(Ads) || get_ival(Fire)) { if (abs(get_ival(PS4_LX)) <= 35 && abs(get_ival(PS4_LY)) <= 35) {combo_run(AimBot2);} else {combo_stop(AimBot2);}combo_run(Shake1)if(abs(get_val(PS4_RY)) > 15 || abs(get_val(PS4_RX)) > 15)combo_stop(Shake1)combo_run(Shake2)if(abs(get_val(PS4_RY)) > 16 || abs(get_val(PS4_RX)) > 16)combo_stop(Shake2)combo_run(Shake3)if(abs(get_val(PS4_RY)) > 17 || abs(get_val(PS4_RX)) > 17)combo_stop(Shake3)combo_run(Shake4)if(abs(get_val(PS4_RY)) > 18 || abs(get_val(PS4_RX)) > 18)combo_stop(Shake4)combo_run(Shake5)if(abs(get_val(PS4_RY)) > 19 || abs(get_val(PS4_RX)) > 19)combo_stop(Shake5)combo_run(Shake6)if(abs(get_val(PS4_RY)) > 20 || abs(get_val(PS4_RX)) > 20)combo_stop(Shake6)}
}if(PolarAimBot){AX = get_val(XB1_RX); AY = get_val(XB1_RY); AM = isqrt(pow(AX, 2) + pow(AY, 2) ); MM = (AM < 100); if(!(T++ % 1) ) { A += 30; }A = A % 360; SA = ScriptN[A % 360]; CA = ScriptN[(A + 270) % 360];CA = (CA * AimBotModePS) / 100; SA = (SA * AimBotModePS) / 100; if (AM <= AimBotModePS) { SA -= AY; CA -= AX; } else{ SA = (SA * (200 - ((abs(AY) + AM) / 10) * 10) / 200) * MM; CA = (CA * (200 - ((abs(AX) + AM) / 10) * 10) / 200) * MM; } set_val(XB1_RX, clamp(AX + CA, -100, 100));set_val(XB1_RY, clamp(AY + SA, -100, 100));}
if(PlayerTracking2){combo_run(LongRangeAccuracyAssist)}
if(AimEnhancer){combo_run(AimBot12)if(abs(get_val(PS4_RX)) >= 12 || abs(get_val(PS4_RY)) >= 12)combo_stop(AimBot12)combo_run(AimBot13)if(abs(get_val(PS4_RX)) >= 13 || abs(get_val(PS4_RY)) >= 13)combo_stop(AimBot13)combo_run(AimBot14)if(abs(get_val(PS4_RX)) >= 14 || abs(get_val(PS4_RY)) >= 14)combo_stop(AimBot14)combo_run(AimBot15)if(abs(get_val(PS4_RX)) >= 15 || abs(get_val(PS4_RY)) >= 15)combo_stop(AimBot15)combo_run(AimBot16)if(abs(get_val(PS4_RX)) >= 16 || abs(get_val(PS4_RY)) >= 16)combo_stop(AimBot16)combo_run(AimBot17)if(abs(get_val(PS4_RX)) >= 17 || abs(get_val(PS4_RY)) >= 17)combo_stop(AimBot17)}
if(AimEnhancer1){combo_run(AimBot18)if(abs(get_val(PS4_RX)) >= 15||abs(get_val(PS4_RY)) >= 15||abs(get_val(PS4_RX)) <=-15||abs(get_val(PS4_RY))<= -15)combo_stop(AimBot18)combo_run(AimBot19)if(abs(get_val(PS4_RX)) >= 17||abs(get_val(PS4_RY)) >= 17||abs(get_val(PS4_RX)) <=-15||abs(get_val(PS4_RY))<= -15)combo_stop(AimBot19)combo_run(AimBot20)if(abs(get_val(PS4_RX)) >= 18||abs(get_val(PS4_RY)) >= 18||abs(get_val(PS4_RX)) <=-15||abs(get_val(PS4_RY))<= -15)combo_stop(AimBot20)combo_run(AimBot21)if(abs(get_val(PS4_RX)) >= 19||abs(get_val(PS4_RY)) >= 19||abs(get_val(PS4_RX)) <=-15||abs(get_val(PS4_RY))<= -15)combo_stop(AimBot21)combo_run(AimBot22)if(abs(get_val(PS4_RX)) >= 20||abs(get_val(PS4_RY)) >= 21||abs(get_val(PS4_RX)) <=-15||abs(get_val(PS4_RY))<= -15)combo_stop(AimBot22)}
if(PolarAimBot1){combo_run(PolarLock)if (get_ival(Ads) && get_ptime(Ads) <= 5000 || PolarAimBot1 && get_ival(Fire) && get_ptime(Fire) <= 5000) { PolarLock1(); }  else if (get_ival(Ads)|| PolarAimBot1 && get_ival(Fire)) { PolarLock1(); } if (!get_ival(Ads) && !get_ival(Fire)) { AAT = 0; Axis = 0; }}
if(Negator){if(get_ival(Ads) && get_ival(Fire)) { 	combo_run(Antirecoil);   combo_run(NegatorB);if(abs(get_val(XB1_LX)) > 10||abs(get_val(XB1_LY)) > 10){ combo_stop(NegatorB); }}}
if(LightingPickUp && get_val(pickup))combo_run(LightingPickUp);
if(Dropshot){if(event_release(Fire)){Dropshot=FALSE;}{if(get_val(Fire) && event_press(Crouch)){Dropshot=TRUE;}}if(Dropshot)if(get_ival(Fire)){combo_run(CrouchShot);}if(Dropshot)if(get_ival(Fire))combo_run(CrouchShot);if (Shunt) if (event_release(Shunt)) Shunt = FALSE;}
if(RapidFire){if(get_ival(Fire)){combo_run(RapidFire);}}else {combo_stop(RapidFire)}
if(AutoJump) {if (get_ival(XB1_RX)) {combo_run(AutoJump);} else {combo_stop(AutoJump);}}
if(PreFireMacro) {if (get_val (PreFireMacro1) && get_val (Fire)) { combo_run (PreFireMacro)}}}
if(HeadLock){if(get_val(PS4_L2))if(get_val(PS4_R2))combo_run(HeadShotMode)if(abs(get_val(PS4_RY)) >= HeadAssist)combo_stop(HeadShotMode)}
}
combo PolarLock{
if(abs(get_val(LX)) + abs(get_val(LY)) < 15)
PolarLock(POLAR_LS,clamp(POLAR,POLAR,100 - 100))wait(50)
set_val(LX,POLAR)wait(1)}function PolarLock(int sensX_polar,Value_polar) {sensX_polar = (clamp(RX,100,-100))Value_polar = (clamp(RY,100,-100))set_val(sensX_polar,clamp(get_val(Value_polar),POLAR ,POLAR+ 100 - 100))set_val(sensX_polar,Value_polar)return get_val(sensX_polar)return Value_polar}
combo LongRangeAccuracyAssist {
set_val(XB1_RX,get_ival(XB1_RX) + AimBotModeLRS);wait(4);
set_val(XB1_RY,get_ival(XB1_RY) - AimBotModeLRS);wait(4);
set_val(XB1_RX,get_ival(XB1_RX) - AimBotModeLRS);wait(4);
set_val(XB1_RY,get_ival(XB1_RY) + AimBotModeLRS);wait(4);}
