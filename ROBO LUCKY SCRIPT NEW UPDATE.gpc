set_val(PS4_RX,-AimbotModeRS)wait(1)
set_val(PS4_RY,-AimbotModeRS)wait(1)  }
combo AimBot21 {
set_val(PS4_RX,AimbotModeRS)wait(1)
set_val(PS4_RY,AimbotModeRS)wait(1)  
set_val(PS4_RX,-AimbotModeRS)wait(1)
set_val(PS4_RY,-AimbotModeRS)  }
combo AimBot22 {
set_val(PS4_RX,AimbotModeRS)wait(1)
set_val(PS4_RY,AimbotModeRS)wait(1) 
set_val(PS4_RX,-AimbotModeRS) 
set_val(PS4_RY,-AimbotModeRS)  }
function AA (){
if(PS4_RX + PS4_RY - PS4_LY + PS4_LX > 0)
AimbotModeRS = -AimbotModeRS
if(PS4_RX + PS4_RY - PS4_LY + PS4_LX > -0)
AimbotModeRS = -AimbotModeRS
return;}
combo HeadShotMode {
set_val(PS4_RY,-HeadAssist)wait(10)}
combo LightingPickUp {
set_val(pickup,100)wait(5)
set_val(pickup,0)}
combo CrouchShot {
set_val(Crouch,100)wait(60)
set_val(Crouch,0)wait(30)wait(60);}
combo RapidFire{
set_val(Fire,100)wait(40)
set_val(Fire,0)wait(40)}
combo confirm {
set_val(Confirm,100)
wait(20)
set_val(Confirm,0)
wait(20)}
combo Confirm {
set_val(Confirm,100);wait(50);
set_val(Confirm,0);wait(100);}
combo AutoConfirmMacro {
set_val(Edit,100)
wait(20)
set_val(Reset,100)       
wait(20)
combo_run(confirm)}
combo InstaEditReset {
wait(20)
combo_run(Confirm);}
combo AutoJump {
set_val(Jump,100);wait(50);
set_val(Jump,0);wait(20);
wait(575);}
combo PreFireMacro {
set_val(Fire, 0)}
combo NegatorB{
set_val(XB1_LX,-12); wait(50); 
set_val(XB1_LY,8); wait(30);
set_val(XB1_LX,14); wait(50);
set_val(XB1_LY,-9); wait(30);}
combo Antirecoil {
AntirecoilVertical = get_val(PS4_RY) + ARVert;  
if(AntirecoilVertical > 100) AntirecoilVertical = 100;
if(abs(get_val(PS4_RY)) < abs(ARVert) + 5)
set_val(PS4_RY, (AntirecoilVertical));
AntirecoilHorizontal = get_val(PS4_RX) + ARHoriz;
if(AntirecoilHorizontal > 100) AntirecoilHorizontal = 100;
if(abs(get_val(PS4_RX)) < abs(ARHoriz) + 5)
set_val(PS4_RX, AntirecoilHorizontal);}
function EditAssist () {
EditT += get_rtime();
if (get_ival(EditAssist)) {
if (EditT >= 20)
Press(Select);}}
function Press (Button) {
if (get_ival(Button))return;
set_val(Button,100);}
function PolarLock1() { AAT += get_rtime(); if (!Axis) set_Val(RY,AAT * AimBotModePS / 10); if (Axis == 1) set_Val(RX,AAT * AimBotModePS / 10); if (Axis == 2) set_Val(RY,inv(AAT * AimBotModePS / 10)); if (Axis == 3) { set_Val(RX,inv(AAT * AimBotModePS / 10)); if (AAT > 50) { AAT = 0; Axis = 0; } } else if (AAT > 50) { AAT = 0; Axis += 1; } } function set_Val(Input,Output) { set_val(Input,clamp(Output * (100 - abs(get_ival(Input))) / 100 + get_ival(Input),-100,100)); return; } 
