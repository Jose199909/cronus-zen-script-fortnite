int Head


main {
vm_tctrl(-9);
block_rumble();
deadzone(XB1_LT,XB1_RT,100,100);
if (SukunaAimAutoReset && !get_ival(ADS) && event_press(SukunaAimResetMacro)) { BS = SukunaAimResetMacro;combo_run(SukunaAimResetMacro); } if (SukunaAimAutoConfirm) {if (BA && get_ival(Edit) && get_ptime(Edit) > BAT || !BA && event_press(Edit)) { Y1 = On; Y2 = On; BT = On; } if (Y2) { if (event_release(Select)) {  Y1 = Off;Y2 = Off;BT = Off; }}}if (Y1 || Y2) {if (BAS) { }if (event_press(Reset)) { combo_run (SukunaAimResetConfirm);Y1 = Off;Y2 = Off; }if (event_press(Pickaxe) || event_press(Build) || event_press(ADS)) { Y1 = Off; Y2 = Off;BT = Off; }}
if (BuildTracker) {if(event_press(Build)) {BT = !BT;}if(BT) {BC += get_rtime();if(event_press(Pickaxe) || BC == BuildSyncTime) {BT = Off;BC = 0;}if(get_ival(Wall) || get_ival(Stair) || get_ival(Floor) || get_ival(Cone) || get_ival(Build)) {BC = 0;}}}
if (!BT) {
if (SukunaAimHeadAssist) { if(get_ival(ADS) && get_ival(Fire) || BHFRR && get_ival(Fire)) { combo_run(SukunaAimHeadAssist); } } combo_run (SukunaAimRBGFlow);
if (SukunaAimMagnet) { if(get_ival(Fire)) { combo_run(SukunaAimMagnet); } }
if (SukunaAimPickUpMacro && get_val(Pickup)) { combo_run(SukunaAimPickUpMacro); } 
if (SukunaAimCA) {combo_run(SukunaAimConstantAimBooster1);combo_run(SukunaAimConstantAimBooster2);combo_run(SukunaAimConstantAimBooster3);combo_run(SukunaAimConstantAimBooster4);} InputTime += get_rtime();
if (SukunaAimAA) {X = get_val(RX);Y = get_val(RY);M = isqrt(pow(X, 2) + pow(Y, 2)); MM = (M < 100);if(!(T++ % BAPD)){A += SukunaAimStickyRangeSpeed;}A = A % 360; SA = SukunaAimData[A % 360]; CA = SukunaAimData[(A + 270) % 360];CA = (CA * SukunaAimStickyRange) / 100;SA = (SA * SukunaAimStickyRange) / 100;if((get_val(ADS)) || get_val(Fire)) { if(M <= SukunaAimStickyRange){SA -= Y;CA -= X;}else {SA = (SA * (200 - ((abs(Y) + M) / 10) * 10) / 200) * MM;CA = (CA * (200 - ((abs(X) + M) / 10) * 10) / 200) * MM;} set_val(RX, clamp(X + CA, -100, 100));set_val(RY, clamp(Y + SA, -100, 100));}}
combo_run(SukunaAimAABooster1);if (get_val(RX)<-SukunaAimAA1||get_val(RX)>SukunaAimAA1||get_val(RY)<-SukunaAimAA1||get_val(RY)>SukunaAimAA1||get_val(RX)<-SukunaAimAA1||get_val(RX)>SukunaAimAA1||get_val(RY)<-SukunaAimAA1||get_val(RY)>SukunaAimAA1){combo_stop(SukunaAimAABooster1);}SukunaAimStrafe = (isqrt(pow(get_ival(PS4_RX), 2) + pow(get_ival(PS4_RY), 2)));combo_run(SukunaAimAABooster2);combo_run(SukunaAimAABooster5);combo_run(SukunaAimAABooster4);AxisR  = isqrt(abs(event_press(RX)) * abs(event_press(RX)) + abs(event_press(RY)) * abs(event_press(RY)));if (event_press(RX) || event_press(RY) && event_press(RY) && AxisR <= SukunaAimAARelease || event_press(RY) && AxisR > SukunaAimAARelease) {combo_run(SukunaAimAABooster3);}
if (SukunaAimHeadLock) {if (get_val(ADS) && (get_val(Fire))) {combo_run(SukunaAimHeadLock); } if(abs(get_val(XB1_LX)) > LSDeadZone || abs(get_val(XB1_LY)) > LSDeadZone){ combo_stop(SukunaAimHeadLock); } }
}

combo_run(A)
combo_run(V)
}
combo V{ set_val(LX,BRAV1(LX,BRAV + 1));set_val(LX,BRAV1(LX,BRAV  - 2));set_val(LY,BRAV1(LY,BRAV + 1));set_val(LX,BRAV1(LX,BRAV + 1));set_val(LY,BRAV1(LY,BRAV - 2));set_val(LX,BRAV1(LX,BRAV + 1));set_val(LY,BRAV1(LY,BRAV + 1));}
