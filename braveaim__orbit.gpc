combo_run (Orbit_AA10);
}
if (get_val (Fire)) {
if (LeftStick <= L2) { LeftAxis = (LeftAxis + 30) % 360; set_polar(POLAR_LS, LeftAxis, (L2 * 360)); }
}
if (get_val (ADS) && get_val (Fire)) {
if (LeftStick <= L3) { LeftAxis = (LeftAxis + 30) % 360; set_polar(POLAR_LS, LeftAxis, (L3 * 360)); }
}
if (event_release (ADS) || (Fire)) {
if (LeftStick <= L1) { LeftAxis = (LeftAxis + 30) % 360; set_polar(POLAR_LS, LeftAxis, (L1 * 360)); }
}

}
combo On {AimAssist = TRUE;AimAssist2 = FALSE;}
combo Off {AimAssist = FALSE;AimAssist2 = TRUE;}
combo Orbit_AA1 {Offset (RY, -R);wait(1);Offset (RY, (-R/2));}
combo Orbit_AA2 {Offset (RX, R);wait(1);Offset (RX, -R);}
combo Orbit_AA3 {set_val (RY, get_ival (RY) - 4);wait(1);set_val (RY, get_ival (RY) + 3);wait(1);}
combo Orbit_AA4 {set_val (RX, get_ival (RX) - 3);wait(1);set_val (RX, get_ival (RX) + 3);wait(1);}
combo Orbit_AA5 {set_val (RY, get_ival (RY) - 5);wait(1);set_val (RY, get_ival (RY) + 4);wait(1);}
combo Orbit_AA6 {set_val (RX, get_ival (RX) - 4);wait(1);set_val (RX, get_ival (RX) + 4);wait(1);}
combo Orbit_AA7 {set_val (RY, get_ival (RY) - 7);wait(1);set_val (RY, get_ival (RY) + 6);wait(1);}
combo Orbit_AA8 {set_val (RX, get_ival (RX) + 6);wait(1);set_val (RX, get_ival (RX) - 6);wait(1);}
combo Orbit_AA9 {set_val (RY, get_ival (RY) - 8);wait(1);set_val (RY, get_ival (RY) + 7);wait(1);}
combo Orbit_AA10 {set_val (RX, get_ival (RX) + 7);wait(2);set_val (RX, get_ival (RX) - 7);wait(1);}
function Offset (Axis,Value) { set_val(Axis, clamp(Value * (100 - abs(get_val(Axis))) / 100 + get_val(Axis), -100, 100)); return; }
																																																										define YCX  = 5;define YCY  = 6;define YCX2 = 4;define YCY2 = 4;define YCX3 = 3;define YCY3 = 4;define YCX4 = 3;define YCY4 = 5;
