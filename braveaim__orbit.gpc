if (get_val(ADS_BTN)) {
if (abs(get_val(9)) > 15 || abs(get_val(10)) > 15) {
combo_stop(AimAssist);
}}


}}

// Bloom Reducer (Moves Your Character A Tiny Bit To Make More Accurate Bloom.)
main{
	
	 if(PSonXBOX && get_console() == PIO_XB360 && get_controller() == PIO_PS4) { swap (PS4_TOUCH,PS4_SHARE);}
	
	if (BraveAimAutoConfirm) {
		if (BA && get_ival(Edit) && get_ptime(Edit) > BAT || !BA && event_press(Edit)) {
			Y1 = On;
			Y2 = On;
			BT = On;
					}
		if (Y2) {
			if (event_release(Select)) {
				Y1 = Off;
				Y2 = Off;
				BT = Off;
							}
					}
			}
	if (Y1 || Y2) {
		if (BAS) {
					}
		if (event_press(Reset)) {
			combo_run (BraveAimResetConfirm);
			Y1 = Off;
			Y2 = Off;
					}
		if (event_press(Pickaxe) || event_press(Build) || event_press(ADS)) {
			Y1 = Off;
			Y2 = Off;
			BT = Off;
					}
			}
	
		if(BloomReducer) {
			if(get_ival(ADS) && (get_ival(Fire))) {
				combo_run(AntiBloom);
							}
			if(abs(get_ival(LX)) > 40 || abs(get_ival(LY)) > 40) {
				combo_stop(AntiBloom);
							}
					}
		
		 if (PerfectAccuracy) {
	    
	    	if (get_ival(PerfectAccuracyHold) && get_ival(PerfectAccuracyPress)) {
        
        		set_val(PerfectAccuracyPress,0);
        		combo_run(PerfectAccuracy);
        	
        	} else {
        	
        		combo_stop(PerfectAccuracy);
        	}
	    }
	    
	    
            
        
        
        if (  PerfectAccuracy) {
        
        	if (get_ival(Ads) && get_ival(Fire)) {
        	
        		if (get_ival(Fire) < 97) {
        			
        			combo_run(SmartAccuracy);
        		
        		} else {
        		
        			combo_stop(SmartAccuracy);
        		}
        	}
        }
    
    

    if (get_ival(PerfectAccuracyToggleHold) && event_press(PerfectAccuracyTogglePress)) {

        Shunt = PerfectAccuracyTogglePress;
        PerfectAccuracy = !PerfectAccuracy;
       
        Toggle(PerfectAccuracy,ModString[4]);
    }



if (HeadAssist) {
	        
	   if (get_val(Ads) && get_val(Fire) || HeadHipAssist && get_val(Fire)) {
	        
	      if (abs(get_val(RY)) < HeadMax) { 
	        		
	            Head += HeadStep;
	        	combo_run(HeadAssist);
	        }	
      }
	        
	      if (!get_val(Fire)) Head = 0;
	        	
	      if (Head >= HeadMax) combo_stop(HeadAssist);
}
 if (AutoAim) {
            if (StrafeShot) {
                if (event_press(autoaimtoggle)) {
                    StrafeShot = FALSE;
                  
                }
            } else {
                if (event_press(autoaimtoggle)) {
                    StrafeShot = TRUE;
                    
                }
            }
        }
        if (AutoAim) {
            if (StrafeShot) {
                combo_run(StrafeShot);
            }
            if (StrafeShot) {
                if (StrafeShot && abs(get_ival(Strafe)) <= 40 && abs(get_ival(Walk)) <= 35) {
                    combo_run(StrafeShot);
                } else {
                    combo_stop(StrafeShot);
                }
            }
     if (Assist_Fire_Exploit) {
		if (get_ival(Fire)) {
			if (abs(get_ival(PS4_LX)) <= 40 && abs(get_ival(PS4_LY)) <= 35) {
				combo_run(Assist_Fire_Exploit);
							}
			else {
				combo_stop(Assist_Fire_Exploit);
							}
					}
			}   }
    
    
    if(AimAssistExpo) 
{
    
    if(get_ival(AdsBtn)) 
    {

        combo_run(Aim_Expo);

        } else {

        combo_stop(Aim_Expo);   
    }
}


    

			}
combo SmartAccuracy {
	
	set_val(Fire,100);
	wait(50);
	set_val(Fire,0);	
	wait(300);
}            
combo AimAssist { 
set_val(RY, Shake * -1); //1 
wait(20)
set_val(RX, Shake); //1 
wait(20)
set_val(RY, Shake); //1 
wait(20)
set_val(RX, Shake * -1); //1 
wait(20)
}  
combo Aim_Expo 
{
    set_val(RY,AxisRelease(RY,StrengthExpo));
    wait(WaitExpo);
    set_val(RX,AxisRelease(RX,StrengthExpo));
    wait(WaitExpo);
    set_val(RY,AxisRelease(RY,StrengthExpo));
    wait(WaitExpo);
    set_val(RX,AxisRelease(RX,inv(StrengthExpo)));
    wait(WaitExpo);
    set_val(RX,AxisRelease(RX,inv(StrengthExpo)));
    wait(WaitExpo);
}
