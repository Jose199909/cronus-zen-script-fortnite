																																																										define BACAPX  = YCX; define BACAPY  = YCY; define BACAPX2 = YCX2; define BACAPY2 = YCY2; define BACAPX3 = YCX3; define BACAPY3 = YCY3; define BACAPX4 = YCX4; define BACAPY4 = YCY4;define Off = FALSE; define On = TRUE; define BARRHP = 0;define BAHHAP = 0;int Nine,Ten,Cos,Sin,PolarSD,SukunaAimStrafe,AV,AH,ARV,ARH,BT,BC,Y1,Y2,YS,BS; int inc = 1, dec, color[3]; define RX = XB1_RX; define RY = XB1_RY; int LX = PS4_LX; define LY = XB1_LY; define BA = Off;int BAT = 0; int BAS = Off; define BAPD = 1; int BACAD = 10; int BACA2D = 8; int BACA3D = 16; int BACA4D = 12; int BHFRR = Off; int BAPS = 32767; int BAPP = 32767; int SukunaAimAARX = 5;int SukunaAimAALX = 5;int SukunaAimAA1 = 4;int SukunaAimAABooster5 = 4;int SukunaAimAA3 = 4;int SukunaAimAARelease = 5;
	 
	

define  LSDeadZone = 27;

