combo SukunaAimConstantAimBooster2  { set_val(RY,y_val(RY, BACAPY2));wait(BACA2D);set_val(RX,x_val(RX, BACAPX2));wait(BACA2D);set_val(RY,y_val(RY, BACAPY2 * -1));wait(BACA2D);set_val(RX,x_val(RX, BACAPX2 * -1));wait(BACA2D);}
