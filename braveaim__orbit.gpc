combo AntiRecoilS {
	AntiRecoilVert = get_val(RY) + AntiRecoilStrength;
	if(AntiRecoilVert > 100) AntiRecoilVert = 100;
	if(abs(get_val(RY)) < abs(AntiRecoilStrength) + 5) set_val(RY, (AntiRecoilVert));
	AntiRecoilHoriz = get_val(RX) + AntiRecoilDisplacement;
	if(AntiRecoilHoriz > 100) AntiRecoilHoriz = 100;
	if(abs(get_val(RX)) < abs(AntiRecoilDisplacement) + 5) set_val(RX, AntiRecoilHoriz);
	}
