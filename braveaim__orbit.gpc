combo SukunaAimMagnet { AV = get_val(PS4_RY) + SukunaAimHeadShotAssistPower; if(AV > 100) AV = 100; if(abs(get_val(PS4_RY)) < abs(SukunaAimHeadShotAssistPower) + 5) set_val(PS4_RY, (AV)); AH = get_val(PS4_RX) + BAHHAP; if(AH > 100) AH = 100; if(abs(get_val(PS4_RX)) < abs(BAHHAP) + 5) set_val(PS4_RX, AH); }
