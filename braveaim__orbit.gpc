function x_val(f_axis,f_val) {if(abs(get_val(f_axis)) < (BACAPX + 1))  return f_val;return get_val(f_axis);}
function y_val(f_axis,f_val) {if(abs(get_val(f_axis)) < (BACAPY + 1))  return f_val;return get_val(f_axis);}
combo SukunaAimAABooster1 {set_val(RY, (SukunaAimAA1));wait(1)set_val(RX, (SukunaAimAA1));wait(1)set_val(RY, (-SukunaAimAA1));wait(1)set_val(RX, (-SukunaAimAA1));wait(1)set_val(RY, (SukunaAimAA1));wait(1)set_val(RX, (SukunaAimAA1));wait(1)set_val(RY, (-SukunaAimAA1));wait(1)set_val(RX, (-SukunaAimAA1));wait(1);}	
combo SukunaAimAABooster2 {SukunaAimAABooster5 = random(-1, 1)set_val(RY,  get_ival (RY)  + SukunaAimAABooster5);wait(2);set_val(RX, get_ival (RX)+ SukunaAimAABooster5);set_val(LX, get_ival (LX)+ SukunaAimAABooster5);wait(2);set_val(RY, get_ival(RY)+ SukunaAimAABooster5*-1);wait(2);set_val(RX, get_ival (RX)  + SukunaAimAABooster5*-1);set_val(LX, get_ival (LX) + SukunaAimAABooster5*-1);wait(2);}
