//little shake change c aim assist value for more or less shake enjoy!!




define Ads             = PS4_L2;        // XB1_LT
define Fire            = PS4_R2;        // XB1_RT 
define interact          = XB1_X;        // XB1_X
define Crouch          = PS4_R3;        // XB1_RS
define Build           = PS4_CIRCLE;    // XB1_B
define Pickaxe         = PS4_TRIANGLE;  // XB1_Y
define RX              = PS4_RX;        // XB1_RX
define RY              = PS4_RY;        // XB1_RY
define LX              = PS4_LX;        // XB1_LX
define LY              = PS4_LY;        // XB1_LY

int BloomReducer = TRUE;  
int ast                = 50;

define PickupMacroR1L1 = TRUE; // hold your left and right bumper TO ACTIVATE pickup macro



main {
	if(get_ival(XB1_RT) > 5){	// Check if RT/R2 (RIGHT TRIGGER) is held at greater than 5%
		set_val(XB1_RT,100);	// Output RT/R2 (RIGHT TRIGGER) at 100%
	}
	if(get_ival(XB1_LT) > 5){	// Check if LT/L2 (LEFT TRIGGER) is held at greater than 5%
		set_val(XB1_LT,100);	// Output LT/L2 (LEFT TRIGGER) at 100%
	}
}

int strength = 7	// Aim Assist Strength
main {
    	if(get_ival(XB1_LT)){	// Check if LT/L2 (LEFT TRIGGER) is held (ADS button for most games)
    		combo_run(cAimAssist);
    	}
    	if(!get_ival(XB1_LT)){	// Check if LT/L2 (LEFT TRIGGER) is held (ADS button for most games). If it is not stop running Aim Assist
    		combo_stop(cAimAssist);
    	}
}
combo cAimAssist{
	set_val(XB1_RY,get_ival(XB1_RY) + strength);	// RIGHT ANALOG DOWN
	wait(40);	// Movement Time
	set_val(XB1_RX,get_ival(XB1_RX) + strength);    // RIGHT ANALOG LEFT
	wait(40);	// Movement Time
	set_val(XB1_RY,get_ival(XB1_RY) + strength);    // RIGHT ANALOG UP
	wait(40);	// Movement Time
	set_val(XB1_RX,get_ival(XB1_RX) + strength);    // RIGHT ANALOG RIGHT
	wait(40);	// Movement Time
}


main {


if(BloomReducer) {
  if(get_val(Ads) && (get_val(Fire))) {        
  combo_run(AntiBloom);
  }
  if(abs(get_val(PS4_LX)) > 40 || abs(get_val(PS4_LY)) > 40){
  combo_stop(AntiBloom);
      }
   }
}

combo AntiBloom { set_val(PS4_LX,-40);wait(ast);set_val(PS4_LX, 40);wait(ast);if(ast < 160){ast = ast + 10;}else {ast = 100;}}

combo PickupMacro {
	set_val (XB1_X, 100);
	wait(1);
	set_val (XB1_X, 0);
	wait(1);
	}
main {




if (PickupMacroR1L1 && get_val(XB1_RB) && get_val(XB1_LB)) {
    combo_run(PickupMacro);
}
}
  	
  

