																																																									*/

// Toggle each mod: TRUE = ON, FALSE = OFF
																																																									/*
Super Sticky Aim Assist 																																																			*/
int StickyAA = FALSE; // Sticky Aim Assist keeps your aim glued to the target for easier tracking
																																																									/*
Strong Hip-Abuse																																																					*/
int HipAbuse = FALSE; // Increased Hip-Abuse boosts aim assist for stronger target tracking
																																																									/*
Headshot Assist (NEW!)																																																				*/
int HeadAssist = FALSE; // Headshot Assist boosts aim assist for stronger head assist
																																																									/*
Slide Tracking (NEW!)																																																				*/
int SlideAssist = FALSE; // Slide Tracking gives you aim assist when you're sliding
																																																									/*
Auto Tracking																																																						*/
int AutoAim = TRUE;
define autoaimtoggle = PS5_SHARE; // Button to toggle AutoTracking

int AimAssist_Strength = 15; // Keep values between 2–15 to reduce leg shake. It won’t remove it fully, but staying in that range helps a lot




















