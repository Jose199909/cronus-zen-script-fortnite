// Toggle each mod: TRUE = ON, FALSE = OFF
																																																									/*
Input Delay Reducer	(NEW!)																																																			*/
int DelayReducer = FALSE; // Input Delay Reducer cuts lag between input and action — faster response, smoother gameplay
																																																									/*
Hair Triggers (NEW!)																																																				*/
int HairTriggers = FALSE; // Hair Triggers turns L2/LT and R2/RT into ultra-sensitive mouse clicks for faster reacting
																																																									/*
Bloom Reducer (NEW!)																																																				*/
int BloomReducer = FALSE; // Bloom Reducer makes your legs shake when holding R2 which reduces bloom when shooting
																																																									/*
Anti Recoil (Recommend for Zero Build ONLY)																																															 */
int antirecoil = TRUE; 
int AR_Ver = 21; // I recommend using values between 15-25, but feel free to choose what works best for you.
																																																									/*
Pickup Macro																																																						*/
int PickupMacro = FALSE;
define Interact = PS5_SQUARE; // Interacting and Reloading
																																																									/*
Instant Reset Macro (Skip this if you play Zero Build)																																												*/
int InstaReset = FALSE;
define Edit = PS5_L3; // Editing a Building
define Reset = PS5_R3; // Resetting an Edit
define instareset = PS5_DOWN; // Activates "Instant Reset" Macro
																																																									/*
   
   _   ___ __  __   __  __  ___  ___  ___ 
  /_\ |_ _|  \/  | |  \/  |/ _ \|   \/ __|
