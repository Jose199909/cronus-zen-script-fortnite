																																																									define Strafe = PS5_LX; define Walk = PS5_LY; define RX = PS5_RX; define RY = PS5_RY; define LX = PS5_LX; define LY = PS5_LY; define aimY = PS5_RY; define aimX = PS5_RX;
define AdsBtn = PS5_L2 		// Aiming
define FireBtn = PS5_R2 	// Shooting
																																																									/*
 __  __ ___ ___  ___   ____  __   _   ___ ___  ___  ___ 
