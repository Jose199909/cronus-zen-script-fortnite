le(f_idx, f_toggle) {    if(ModIdx == f_idx) {        if(f_idx == RecoilBlock) {            if(f_toggle == 1) print(center_x(3, OLED_FONT_SMALL_WIDTH), LINE_3_Y, OLED_FONT_SMALL, OLED_WHITE, ON[0]);            else print(center_x(4, OLED_FONT_SMALL_WIDTH), LINE_3_Y, OLED_FONT_SMALL, OLED_WHITE, OFF[0]);        } else {            if(f_toggle == 1) print(center_x(3, OLED_FONT_SMALL_WIDTH), LINE_3_Y, OLED_FONT_SMALL, OLED_WHITE, ON[0]);            else print(center_x(4, OLED_FONT_SMALL_WIDTH), LINE_3_Y, OLED_FONT_SMALL, OLED_WHITE, OFF[0]);        }    }}function draw_chars_line2() {    ButtonLeft = LEFT;    ButtonRight = RIGHT;    rect_oled(3, 19, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 1, OLED_WHITE, col_rec_left);    rect_oled(116, 19, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 1, OLED_WHITE, col_rec_right);    putc_oled(1, ButtonLeft);    puts_oled(LEFT_X, LINE_2_Y, OLED_FONT_SMALL, 1, col_char_left);    putc_oled(1, ButtonRight);    puts_oled(RIGHT_X, LINE_2_Y, OLED_FONT_SMALL, 1, col_char_right);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction draw_chars_line3() {    ButtonLeft = DOWN;    ButtonRight = UP;    rect_oled(3, 35, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 1, OLED_WHITE, col_rec_left);    rect_oled(116, 35, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 1, OLED_WHITE, col_rec_right);    putc_oled(1, ButtonLeft);    puts_oled(LEFT_X, LINE_3_Y, OLED_FONT_SMALL, 1, col_char_left);    putc_oled(1, ButtonRight);    puts_oled(RIGHT_X, LINE_3_Y, OLED_FONT_SMALL, 1, col_char_right);}function animate_buttons() {    if(MenuActive) {        if(event_press(PS4_LEFT)) {            col_char_left = 1; col_char_right = 0; col_rec_left = 0; col_rec_right = 1;            draw_chars_line2();        }        if(event_release(PS4_LEFT)) {            col_char_left = 0; col_char_