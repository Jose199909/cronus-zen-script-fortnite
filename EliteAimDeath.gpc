E) < 200) {            KillSwitch = FALSE;            combo_run(RUMBLE_ON);            cls_oled(OLED_BLACK);        }    }    if(KillSwitch) set_rgb(50,0,0);    else if(BuildTrack) set_rgb(0, 50, 0);    else set_rgb(50, 50, 50);    if(KillSwitch) {        combo_run(KILL_DISPLAY);    } else {        combo_stop(KILL_DISPLAY);        if(!MenuActive) {            if(get_val(PS4_L1) && event_press(PS4_OPTIONS)) {                MenuActive = TRUE;                redraw = TRUE;                guide_idx = 0;                guide_timer = 0;                combo_run(RUMBLE_ON);                display_guide();            }        } else {            if(event_press(PS4_LEFT)) {                ModIdx = cycle(ModIdx - 1, 0, 6);                display_line2();                display_line3();            }            if(event_press(PS4_RIGHT)) {                ModIdx = cycle(ModIdx + 1, 0, 6);                display_line2();                display_line3();            }            eTrackingToggle = toggle(eTracking, eTrackingToggle);            LaserPickupToggle = toggle(LaserPickup, LaserPickupToggle);            LaserResetToggle = toggle(LaserReset, LaserResetToggle);            BuildTrackerToggle = toggle(BuildTracker, BuildTrackerToggle);            DropshotToggle = toggle(Dropshot, DropshotToggle);            RapidFireToggle = toggle(RapidFire, RapidFireToggle);            RecoilBlockToggle = toggle(RecoilBlock, RecoilBlockToggle);            if(display_update) {                display_line3();                 display_update = FALSE;             }            if(get_val(PS4_L1) && event_press(PS4_OPTIONS)) {                MenuActive = FALSE;                combo_stop(ANIMATE_TITLE);                cls_oled(OLED_BLACK);                reset_button_states();                combo_run(RUMBLE_OFF);            }            if(get_val(PS4_CIRCLE)) {                combo_stop(ANIMATE_TITLE);                combo_run(SAVE_SETTINGS);            }            if(redraw) {                combo_run(DRAW_MENU);                redraw = FALSE;            }            animate_buttons();            guide_timer += get_rtime();            if(guide_timer >= 4000) {                guide_idx++;                if(guide_idx > 2) guide_idx = 0;                display_guide();                guide_timer = 0;            }            if(MenuActive && !combo_running(SAVE_SETTINGS)) {                combo_run(ANIMATE_TITLE);            }        }// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIP        picture_time += get_rtime();         frame_time += get_rtime();        if(stage == 0) {             if(frame_time >= (BASE_FRAME_TIME + slowdown)) {                 cls_oled(OLED_BLACK);                 image_oled(0, 0, TRUE, TRUE, picture[current_frame]);                 current_frame++;                 slowdown = slowdown + 5;                 if(slowdown > MAX_SLOWDOWN) slowdown = MAX_SLOWDOWN;                 frame_time = 0;                 if(current_frame >= FRAME_COUNT) current_frame = FRAME_COUNT - 1;             }            if(picture_time >= ANIMATION_TIME) {                 cls_oled(OLED_BLACK);                 stage = 1;                 picture_time = 0;                 frame_time = 0;                 current_frame = 0;                 slowdown = 0;             }        } else if(stage == 1) {            if(picture_time >= PAUSE_TIME) {                 stage = 2;                 picture_time = 0;             }        } else if(stage == 2) {             cls_oled(OLED_BLACK);             print(5, 6, OLED_FONT_MEDIUM, OLED_BLACK, text[0]);             print(5, 40, OLED_FONT_SMALL, OLED_WHITE, text[1]);              if(picture_time >= TEXT_TIME) {                 cls_oled(OLED_BLACK);                 stage = 3;                 screen_saver = TRUE;                 picture_time = 0;                 for(i = 0; i < MAX_STARS; i++) {                     star_x[i] = random(0, SCREEN_WIDTH - 1);                     star_y[i] = random(0, SCREEN_HEIGHT - 1);                     star_state[i] = random(0, 1);                     star_delay[i] = random(MIN_DELAY, MAX_DELAY);                     star_timer[i] = random(0, star_delay[i]);                     if(star_state[i]) pixel_oled(star_x[i], star_y[i], OLED_WHITE);                 }             }        } else if(stage == 3) {            for(i = 0; i < MAX_STARS; i++) {                 star_timer[i] += get_rtime();                 if(star_timer[i] >= star_delay[i]) {                     if(star_state[i]) {                         pixel_oled(star_x[i], star_y[i], OLED_BLACK);                         star_state[i] = 0;                         star_x[i] = random(0, SCREEN_WIDTH - 1);                         star_y[i] = random(0, SCREEN_HEIGHT - 1);                     } else {                         pixel_oled(star_x[i], star_y[i], OLED_WHITE);                         star_state[i] = 1;                     }                     star_delay[i] = random(MIN_DELAY, MAX_DELAY);                     star_timer[i] = 0;                 }             }        }// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIP        if(!KillSwitch) {            if(eTrackingToggle) {                if(!BuildTrack) {                    if(abs(get_ival(LX)) <= 35 && abs(get_ival(LY)) <= 35) {                        combo_run(eTracking);                        combo_run(eTrackingNewAimAssist);                    } else {                        combo_stop(eTracking);                        combo_stop(eTrackingNewAimAssist);                    }                } else {                     combo_stop(eTracking);                    combo_stop(eTrackingNewAimAssist);                }            }            if(LaserPickupToggle && get_val(Interact)) {                if(!BuildTrack) {                    combo_run(LaserPickup);                }            }            if(LaserResetToggle) {                if(!BuildTrack) {                    if(event_press(InstantReset)) {                        combo_run(InstantReset);                    }                }            }            if(BuildTrackerToggle) {                if(event_press(SwitchMode)) {                    BuildTrack = !BuildTrack;                    BuildCount = 0;                }                if(event_press(Pickaxe) && BuildTrack) {                    BuildTrack = FALSE;                    BuildCount = 0;                }                if(BuildTrack) {                    BuildCount += get_rtime();                    if(BuildCount >= BuildSyncTime) {                        BuildTrack = FALSE;                        BuildCount = 0;                    }                    if(get_ival(PS4_L1) || get_ival(PS4_R2) || get_ival(PS4_L2) || get_ival(PS4_R1)) {                        BuildCount = 0;                    }                }            }            if(DropshotToggle) {                if(!BuildTrack) {                    if(get_val(Fire) && get_val(ADS)) {                        combo_run(Dropshot);                    }                }            }            if(RapidFireToggle) {                if(!BuildTrack) {                    if(get_val(Fire) && get_val(ADS)) {                        combo_run(RapidFire);                    }                }            }            if(RecoilBlockToggle && !BuildTrack) {                if(get_val(ADS) && get_val(Fire)) {                    currentRecoil = get_movement_recoil();                    set_val(RY, restrict_val(get_val(RY) + currentRecoil, -100, 100));                }            }        }    }}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo RUMBLE_ON {    set_ledx(2, 2);    set_rumble(RUMBLE_B, 50);    wait(350);    reset_rumble();    wait(100);    set_rumble(RUMBLE_B, 50);    wait(150);    reset_rumble();}combo RUMBLE_OFF {    set_ledx(1, 1);    set_rumble(RUMBLE_A, 50);    wait(300);    reset_rumble();    wait(400);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo KILL_DISPLAY {    cls_oled(OLED_BLACK);    print(center_x(15, OLED_FONT_SMALL_WIDTH), 11, OLED_FONT_SMALL, OLED_BLACK, DISABLED[0]);    wait(400);      print(center_x(15, OLED_FONT_SMALL_WIDTH), 34, OLED_FONT_SMALL, OLED_WHITE, REACTIVATE[0]);    wait(200);      print(center_x(17, OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, ACTIVE[0]);    wait(3000);  }combo SAVE_SETTINGS {    cls_oled(OLED_BLACK);    MenuActive = FALSE;    print(center_x(5, OLED_FONT_LARGE_WIDTH), center_y(OLED_FONT_LARGE_HEIGHT), OLED_FONT_LARGE, OLED_WHITE, SAVED[0]);    call(RUMBLE_ON);    save_values();    wait(2500);    cls_oled(OLED_BLACK);    reset_button_states();}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo DRAW_MENU {    cls_oled(OLED_BLACK);    wait(10);    draw_base_menu();    wait(10);    draw_mod_menu();    wait(10);    display_guide();    wait(10);    display_line2();    wait(10);    display_line3();    wait(10);    display_title();    wait(10);    draw_chars_line2();    wait(10);    draw_chars_line3();}combo ANIMATE_TITLE {    rect_oled(13, 49, 102, OLED_FONT_SMALL_HEIGHT + 2, OLED_WHITE, OLED_BLACK);    print(center_x(11, OLED_FONT_SMALL_WIDTH), TITLE_Y, OLED_FONT_SMALL, OLED_WHITE, TITLE[0]);    line_oled(1, 62, 126, 62, 1, OLED_WHITE);    wait(800);    rect_oled(13, 49, 102, OLED_FONT_SMALL_HEIGHT + 2, OLED_WHITE, OLED_BLACK);    print(center_x(11, OLED_FONT_SMALL_WIDTH), TITLE_Y, OLED_FONT_SMALL, OLED_BLACK, TITLE[0]);    line_oled(1, 62, 126, 62, 1, OLED_WHITE);    wait(800);}combo eTracking {    set_val(LX, -100);    wait(1);    set_val(LX, 100);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo eTrackingNewAimAssist {    prev_RX = get_lval(PS4_RX);    prev_RY = get_lval(PS4_RY);    current_RX = get_val(PS4_RX);    current_RY = get_val(PS4_RY);    scaling_factor = calculate_scaling_factor(current_RX, current_RY, prev_RX, prev_RY);    angle = calculate_angle(current_RX - prev_RX, current_RY - prev_RY);    angleDifference = abs(DESIRED_ANGLE - angle);    rotationalAssistFactor = (180 - angleDifference) * ROTATIONAL_ASSIST_STRENGTH / 180;    smoothed_RX = prev_RX + (current_RX - prev_RX) * SMOOTHING_FACTOR / 100;    smoothed_RY = prev_RY + (current_RY - prev_RY) * SMOOTHING_FACTOR / 100;    if(get_val(PS4_RX) < 0) {        ax = -400;    } else {        ax = 400;    }    if(get_val(PS4_RY) < 0) {        ay = -400;    } else {        ay = 400;    }    adjusted_RX = smoothed_RX + (scaling_factor * rotationalAssistFactor / ax);    adjusted_RY = smoothed_RY + (scaling_factor * rotationalAssistFactor / ay);    set_val(PS4_RX, adjusted_RX);    set_val(PS4_RY, adjusted_RY);    if(get_ival(PS4_SQUARE) || get_ival(PS4_LY) < -25 || get_ival(PS4_LY) > 25) {        set_val(PS4_LX, get_val(PS4_LX));    } else {        set_val(PS4_LX, get_val(PS4_LX) + LED[A] / 5);    }    A = (A + 1) % SIZE;    wait(10);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo LaserPickup {     set_val(Interact, 100);     wait(1);    set_val(Interact, 0);    wait(1);}combo InstantReset {    set_val(Edit, 100);    wait(ButtonTime);    set_val(Reset, 100);    wait(ButtonTime);    combo_run(Confirm);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo Confirm {    set_val(Confirm, 100);    wait(ButtonTime);    set_val(Confirm, 0);    wait(ButtonTime);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo Dropshot {    set_val(Crouch, 100);    wait(50);    set_val(Crouch, 0);    wait(50);}combo RapidFire {    set_val(Fire, 100);    wait(40);    set_val(Fire, 0);    wait(40);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPcombo vibrate1 {    set_rumble(RUMBLE_A, 50);    wait(300);    set_rumble(RUMBLE_A, 100);    wait(600);    reset_rumble();    greetings = FALSE;}function deathtracking(int val1, val2) {    if(Initiate(Return(val1)) < 10) set_val(val1, val2);}function Initiate(int abs) {    if(abs < 0) abs = inv(abs);    return abs;}function Return(int getvalue) {    getvalue = get_val(getvalue);    return getvalue;}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction draw_base_menu() {    rect_oled(0, 0, 128, 64, OLED_BLACK, OLED_WHITE);    line_oled(1, 16, 126, 16, 1, OLED_WHITE);    line_oled(1, 48, 126, 48, 1, OLED_WHITE);    line_oled(1, 62, 126, 62, 1, OLED_WHITE);}function draw_mod_menu() {    rect_oled(1, 17, 126, 31, OLED_WHITE, OLED_BLACK);    line_oled(1, 32, 126, 32, 1, OLED_WHITE);    rect_oled(2, 18, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);    rect_oled(115, 18, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIG