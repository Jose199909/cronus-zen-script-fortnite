string(f_array_idx, f_idx) {    if(f_array_idx == MODS_TXT) return MODS[f_idx];    if(f_array_idx == GUIDE_TXT) return GUIDE[f_idx];    return -1;}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPint str_length;function get_string_length(offset) {    str_length = 0;    while(duint8(offset++)) { str_length++ }    return str_length + 1;}function cycle(f_val, f_lo, f_hi) {    if(f_val > f_hi) return f_lo;    if(f_val < f_lo) return f_hi;    return f_val;}function center_x(chars, font) {    return (OLED_WIDTH / 2) - ((chars * font) / 2);}function center_y(size) {    return (OLED_HEIGHT / 2) - (size / 2);}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction save_values() {    set_pvar(SPVAR_1, eTrackingToggle);    set_pvar(SPVAR_2, RecoilBlockToggle);    set_pvar(SPVAR_3, LaserPickupToggle);    set_pvar(SPVAR_4, DropshotToggle);    set_pvar(SPVAR_5, RapidFireToggle);    set_pvar(SPVAR_6, LaserResetToggle);    set_pvar(SPVAR_7, BuildTrackerToggle);}function get_movement_recoil() {    movementInput = get_val(LY) * get_val(LY);    if(movementInput < 200) {        return movementrecoil[0];    }    return 0;}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction dz(f_axis, f_val) {    f_val = get_val(f_axis);    if(abs(f_val) < 10) {        set_val(f_axis, 0);        return 0;    }    return f_val;}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction calculate_angle(int dx, int dy) {    dx = get_val(PS4_RX) - get_lval(PS4_RX);    dy = get_val(PS4_RY) - get_lval(PS4_RY);    angle = abs(dx) + abs(dy);    if(dx >= 0) {        if(dy >= 0) {            return angle;        } else {            return 180 - angle;        }    } else {        if(dy >= 0) {            return 360 - angle;        } else {            return 180 + angle;        }    }    return angle;}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction calculate_scaling_factor(current_RX, current_RY, prev_RX, prev_RY) {    prev_RX = get_lval(PS4_RX);    prev_RY = get_lval(PS4_RY);    current_RX = get_val(PS4_RX);    current_RY = get_val(PS4_RY);    delta_RX = current_RX - prev_RX;    delta_RY = current_RY - prev_RY;    speed_squared = delta_RX * delta_RX + delta_RY * delta_RY;    speed = speed_squared;    bit = 1 << 30;    while(bit > speed) {        bit = bit >> 2;    }    approx = ((get_polar(POLAR_RS, POLAR_RADIUS)) / (delta_RX + delta_RY + delta_RX + delta_RY + 1));    while(bit != 0) {        if(speed >= approx + bit) {            speed -= approx + bit;            approx = (approx >> 1) + bit;        } else {            approx = approx >> 1;        }        bit = bit >> 2;    }    scaling_factor = SCALING_FACTOR * (approx / 100);    return scaling_factor;}// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIPfunction restrict_val(val, min, max) {    if(val < min) return min;    if(val > max) return max;    return val;} // COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIP// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIP// COLDZ ZEN VIP IS THE BEST!// discord.gg/coldz// BEST FREE ZEN SCRIPTS AND VIP// THIS WAS LEAKED BY COLDEST IN VIP// COLDZ ZEN VIP IS THE BEST!// disc