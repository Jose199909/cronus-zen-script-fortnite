define On = TRUE;
define Off = FALSE;
int StrafeWait = 1;
int StrafeShot = TRUE;
int greetings = TRUE;

init {
    if(AutoAim){    
        cls_oled(OLED_BLACK);
        print(3, 25, OLED_FONT_MEDIUM, OLED_WHITE, Features[0]);
        print(3, 50, OLED_FONT_SMALL, OLED_WHITE, Script[0]);
        print(3, 10, OLED_FONT_SMALL, OLED_WHITE, AutoOn[0]);
        set_rgb(0, 255, 255);
    }
    else {
        cls_oled(OLED_BLACK);
        print(20, 25, OLED_FONT_MEDIUM, OLED_WHITE, Features[0]);
        print(38, 45, OLED_FONT_SMALL, OLED_WHITE, Script[0]);
        set_rgb(0, 255, 255);
    }
}

main {
    if(greetings){
        combo_run(vibrate1);
    }

    if(InstaReset){
        if(get_val(instareset)){
            combo_run(insta);
        }
    }
    if (get_val(AdsBtn) > 0) {
        set_val(AdsBtn, 100);
    }
    if (get_val(FireBtn) > 0) {
        set_val(FireBtn, 100);
    }
    if (PickupMacro) {
        if (get_val(Interact)) {
            combo_run(pickupmacro);
        }
        if (event_release(Interact)) {
            combo_stop(pickupmacro);
        }
        if (get_val(PS5_L2)) {
            combo_stop(pickupmacro);
        }
    }
    if(AutoAim){
        if(StrafeShot){    
            if(event_press(autoaimtoggle)){
                StrafeShot = FALSE;
                autoaim(FALSE);
            }
        }
        else {    
            if(event_press(autoaimtoggle)){
                StrafeShot = TRUE;
                autoaim(TRUE);
            }
        }
    }

    if(AutoAim){
        if(StrafeShot){
            combo_run(StrafeShot);
        }
        if (StrafeShot && abs(get_ival(Strafe)) <= 35 && abs(get_ival(Walk)) <= 35){
            combo_run(StrafeShot);
        }
        else{
            combo_stop(StrafeShot);
        }
    }
}

combo pickupmacro {
    set_val(Interact, 100);
    wait(80);
    set_val(Interact, 0);
}

combo vibrate1 {
    set_rumble(RUMBLE_A, 50);
    wait(300);
    set_rumble(RUMBLE_A, 100);
    wait(600);    
    reset_rumble();
    greetings = FALSE;
}

combo StrafeShot {
    set_val(Strafe, -70);
    wait(StrafeWait);
    set_val(Strafe, 70);
}

combo insta {
    set_val(Edit, 100); 
    wait(40);    
    set_val(Reset, 100); 
    wait(80);
}

function autoaim(state){ 
    if(state){   
        cls_oled(OLED_BLACK);   
        print(3,25,OLED_FONT_MEDIUM,OLED_WHITE,Features[0]);
        print(3,50,OLED_FONT_SMALL,OLED_WHITE,Script[0]);
        print(3,10,OLED_FONT_SMALL,OLED_WHITE,AutoOn[0]);
        set_rgb(0, 255, 255);
        combo_run(vibon);
    }
    else {    
        cls_oled(OLED_BLACK);
        print(3,25,OLED_FONT_MEDIUM,OLED_WHITE,Features[0]);
        print(3,50,OLED_FONT_SMALL,OLED_WHITE,Script[0]);
        print(3,10,OLED_FONT_SMALL,OLED_WHITE,AutoOff[0]);
        set_rgb(255, 0, 0);
        combo_run(viboff);
    }
}

combo vibon {
    set_rumble(RUMBLE_A, 50);
    wait(100);
    set_rumble(RUMBLE_A, 0);
}

combo viboff {
    set_rumble(RUMBLE_B, 50);
    wait(100);
    set_rumble(RUMBLE_B, 0);
}

const string Features = "PULSE V2";
const string Script = "FEATUREZENS.COM"; 
const string AutoOn = "SCRIPT: ON";
