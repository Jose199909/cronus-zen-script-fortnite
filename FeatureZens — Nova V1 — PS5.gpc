                if(get_val(PS5_UP) || get_val(XB1_UP)) {
                    VALUE_HOLD_TIMER += get_rtime();
                    if(event_press(PS5_UP) || event_press(XB1_UP) || (VALUE_HOLD_TIMER > 300 && RAPID_CHANGE_TIMER > 25)) {
                        DropShotDelay++;
                        if(DropShotDelay > 100) DropShotDelay = 100;
                        combo_run(VIBRATION_CHANGE);
                        RAPID_CHANGE_TIMER = 0;
                    }
                    RAPID_CHANGE_TIMER += get_rtime();
                } else if(get_val(PS5_DOWN) || get_val(XB1_DOWN)) {
                    VALUE_HOLD_TIMER += get_rtime();
                    if(event_press(PS5_DOWN) || event_press(XB1_DOWN) || (VALUE_HOLD_TIMER > 300 && RAPID_CHANGE_TIMER > 25)) {
                        DropShotDelay--;
                        if(DropShotDelay < 0) DropShotDelay = 0;
                        combo_run(VIBRATION_CHANGE);
                        RAPID_CHANGE_TIMER = 0;
                    }
                    RAPID_CHANGE_TIMER += get_rtime();
                } else { VALUE_HOLD_TIMER = 0; RAPID_CHANGE_TIMER = 0; }
            }
        }
        
        if(CURRENT_PAGE == 16) {
            SELECTION = InstantTriggersToggle; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(InstantTriggersToggle);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS5_UP) || event_press(XB1_UP) || event_press(PS5_DOWN) || event_press(XB1_DOWN)) { 
                InstantTriggersToggle = !InstantTriggersToggle; 
                FLASH_TOGGLE = InstantTriggersToggle; 
                combo_run(VIBRATION_CHANGE); 
                combo_run(FLASH_TOGGLE_ONOFF); 
            }
        }
        
        if(CURRENT_PAGE == 17) {
            SELECTION = ControllerOverclockToggle; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(ControllerOverclockToggle);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS5_UP) || event_press(XB1_UP) || event_press(PS5_DOWN) || event_press(XB1_DOWN)) { 
                ControllerOverclockToggle = !ControllerOverclockToggle; 
                FLASH_TOGGLE = ControllerOverclockToggle; 
                combo_run(VIBRATION_CHANGE); 
                combo_run(FLASH_TOGGLE_ONOFF); 
            }
        }
        
        if(CURRENT_PAGE == 18) {
            SELECTION = 2; TOGGLE_TYPE = 0; 
            UPDATE_LED_FOR_MOD_STATE(TRUE);
            print(CENTER_X(GET_STRING_LENGTH(COLOUR_NAMES[OLEDColour]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, COLOUR_NAMES[OLEDColour]);
            
            if(event_press(PS5_UP) || event_press(XB1_UP)) {
                OLEDColour++;
                if(OLEDColour > 4) OLEDColour = 0;
                combo_run(VIBRATION_CHANGE);
                UPDATE_LED_FOR_MOD_STATE(TRUE);
            }
            if(event_press(PS5_DOWN) || event_press(XB1_DOWN)) {
                OLEDColour--;
                if(OLEDColour < 0) OLEDColour = 4;
                combo_run(VIBRATION_CHANGE);
                UPDATE_LED_FOR_MOD_STATE(TRUE);
            }
        }
        
        set_val(PS5_RIGHT, 0); set_val(PS5_LEFT, 0);
        set_val(PS5_UP, 0); set_val(PS5_DOWN, 0);
        set_val(PS5_L2, 0); set_val(PS5_R2, 0);
        set_val(XB1_RIGHT, 0); set_val(XB1_LEFT, 0);
        set_val(XB1_UP, 0); set_val(XB1_DOWN, 0);
        set_val(XB1_LT, 0); set_val(XB1_RT, 0);
        
        draw_starfield();
    } else {
        cls_oled(OLED_BLACK);
        draw_NOVA_logo();
        draw_starfield();
        
        HoldingADS = get_ival(ADS);
        HoldingFire = get_ival(Fire);
        
        if(InstantTriggersToggle) {
            if(get_val(PS5_L2) > 0) {
                set_val(PS5_L2, 100);
            }
            
            if(get_val(PS5_R2) > 0) {
                set_val(PS5_R2, 100);
            }
        }
        
        if(InstaResetToggle && event_press(InstantReset)) {
            combo_run(InstantReset);
        }
        
        if(AutoTrackingToggle && abs(get_ival(PS5_LX)) <= 35 && abs(get_ival(PS5_LY)) <= 35) {
            combo_run(AutoTracking);
        } else {
            combo_stop(AutoTracking);
        }
        
        if(AntiRecoilToggle && AntiRecoilPower > 0 && get_val(Fire) && get_val(ADS)) {
            combo_run(AntiRecoil);
        }
        
        if(ConstantAAToggle && ConstantAAPower > 0) {
            combo_run(ConstantAA);
        }
        
        if(L2AssistToggle && PolarPower > 0 && get_val(ADS)) {
            combo_run(L2Assist);
        }
        
        if(R2AssistToggle && R2AssistPower > 0 && get_val(Fire) && !(AntiRecoilToggle && get_val(ADS))) {
            combo_run(R2Assist);
        }
        
        if(PickupMacroToggle && get_val(Interact) && get_val(PS5_R1)) {
            combo_run(PickupMacro);
        }
        
        if(DropShotToggle && DropShotDelay > 0 && get_val(Fire) && get_val(ADS)) {
            combo_run(DropShot);
        }
        
        if(AutoTrackingToggle || ConstantAAToggle || L2AssistToggle || R2AssistToggle || AntiRecoilToggle || PickupMacroToggle || InstaResetToggle || DropShotToggle || InstantTriggersToggle || ControllerOverclockToggle) {
            UPDATE_LED_FOR_MOD_STATE(TRUE);
        }
    }
}␀����������������