et_val(XB1_RX)) > 16 || abs(get_val(XB1_RY)) > 16)combo_stop(FusionAA32)combo_run(FusionAA33)if(abs(get_val(XB1_RX)) > 17 || abs(get_val(XB1_RY)) > 17)combo_stop(FusionAA33)combo_run(FusionAA34)if(abs(get_val(XB1_RX)) > 13 || abs(get_val(XB1_RY)) > 13)combo_stop(FusionAA34)combo_run(FusionAA35)if(abs(get_val(XB1_RX)) > 14 || abs(get_val(XB1_RY)) > 14)combo_stop(FusionAA35)combo_run(FusionAA36)if(abs(get_val(XB1_RX)) > 13 || abs(get_val(XB1_RY)) > 13)combo_stop(FusionAA36)combo_run(FusionAA37)if(abs(get_val(XB1_RX)) > 14 || abs(get_val(XB1_RY)) > 14)combo_stop(FusionAA37)combo_run(FusionAA38)if(abs(get_val(XB1_RX)) > 13 || abs(get_val(XB1_RY)) > 13)combo_stop(FusionAA38)combo_run(FusionAA39)if(abs(get_val(XB1_RX)) > 14 || abs(get_val(XB1_RY)) > 14)combo_stop(FusionAA39)}if (AutoConfirmMacro){if (event_press(AutoConfirmMacro1)) { combo_run(FastReset);}}if (SmartTriggerBot) {if (get_val (SmartTriggerBot1) && get_val (Fire)) { combo_run (PreFireMacro) } }if (PickUpMacro && get_val(PickUpMacro1)) combo_run(PickupSpam);if (RapidFire) {if (get_ival(Fire)) {combo_run(RapidFire);}}else {combo_stop(RapidFire);}}}}
																																																																																			combo RapidFire{set_val(Fire,100);wait(40);set_val(Fire,0);wait(40);}combo PickupSpam {set_val(PickUpMacro1, 100);wait(5);set_val(PickUpMacro1, 0); }combo PreFireMacro {set_val(Fire, 0)}combo Confirm {set_val(Confirm,100);wait(20);set_val(Confirm,0);wait(20);}combo FastReset {set_val(Edit,100);wait(20)set_val(Reset,100);wait(20);combo_run(Confirm);}combo AntiRecoil {Offset_AR(PS4_RY,AntiRecoil_Strength)}combo AntiBloom {set_value(PS4_LX,AntiBloom_Strength)wait(20)set_value(PS4_LX,-AntiBloom_Strength)wait(20)}      combo FusionAA1 {set_value(PS4_RX,FusionAutoTracking)wait(10)set_value(PS4_RY,FusionAutoTracking)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)}      combo FusionAA2 {set_value(PS4_RX,FusionAutoTracking)wait(10)set_value(PS4_RY,FusionAutoTracking)wait(10)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)}      combo FusionAA3 {set_value(PS4_RX,FusionAutoTracking)wait(10)set_value(PS4_RY,FusionAutoTracking)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)wait(10)}      combo FusionAA4 {set_value(PS4_RX,FusionAutoTracking)wait(10)set_value(PS4_RY,FusionAutoTracking)set_value(PS4_RX,-FusionAutoTracking)set_value(PS4_RY,-FusionAutoTracking)}     combo FusionAA5 {set_value(PS4_RX,FusionAutoTracking)set_value(PS4_RY,FusionAutoTracking)wait(10)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)wait(10)}     combo FusionAA6 {set_value(PS4_RX,FusionAutoTracking)wait(10)set_value(PS4_RY,FusionAutoTracking)wait(10)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)}   combo FusionAA7 {set_value(PS4_RX,FusionAutoTracking)set_value(PS4_RY,FusionAutoTracking)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)wait(10)}   combo FusionAA8 {set_value(PS4_RX,FusionAutoTracking)wait(10)set_value(PS4_RY,FusionAutoTracking)wait(10)set_value(PS4_RX,-FusionAutoTracking)wait(10)set_value(PS4_RY,-FusionAutoTracking)wait(10)}       combo FusionAA9 {set_value(PS4_RX,random(FusionPrediction,FusionPrediction * -1))wait(10)set_value(PS4_RY,random(FusionPrediction,FusionPrediction * -1))wait(10)set_value(PS4_RX,random(FusionPrediction,FusionPrediction * -1))wait(10)set_value(PS4_RY,random(FusionPrediction,FusionPrediction * -1))wait(10)} combo FusionAA10 {set_val(XB1_LX,-100);wait(LValueAbuse);set_val(XB1_LX,100);wait(LValueAbuse);}combo FusionAA11 {Feature(PS4_RX,Power) wait(10) Feature(PS4_RY,Power) wait(10) Feature(PS4_RX,-Power) wait(10) Feature(PS4_RY,-Power) wait(10) }combo FusionAA12 {Feature(PS4_RX,Power) Feature(PS4_RY,Power) wait(10) Feature(PS4_RX,-Power) Feature(PS4_RY,-Power) wait(10) }combo FusionAA13 {Feature(PS4_RX,Power) Feature(PS4_RY,Power) wait(10) Feature(PS4_RX,-Power) wait(10)Feature(PS4_RY,-Power) wait(10) }combo FusionAA14 {Feature(PS4_RX,Power) wait(10)Feature(PS4_RY,Power) Feature(PS4_RX,-Power) Feature(PS4_RY,-Power) wait(10) }combo FusionAA15 {Feature(PS4_RX,Power) Feature(PS4_RY,Power) Feature(PS4_RX,-Power) wait(10)Feature(PS4_RY,-Power) wait(10) }combo FusionAA16 {Feature(PS4_RX,Power) wait(10) Feature(PS4_RY,Power) Feature(PS4_RX,-Power) wait(10) Feature(PS4_RY,-Power) wait(10) }combo FusionAA17 {Feature(PS4_RX,Power) Feature(PS4_RY,Power) wait(10) Feature(PS4_RX,-Power) Feature(PS4_RY,-Power) }combo FusionAA18 {set_val(XB1_LX, -100)wait(1)set_val(XB1_LX, 100)}combo FusionAA19 {set_val(PS4_RX,Power)wait(Delay);set_val(PS4_RY,Power)wait(Delay);}combo FusionAA20 {set_val(PS4_RX,-Power)set_val(PS4_RY,-Power)wait(Delay);set_val(PS4_RX,Power)set_val(PS4_RY,Power)wait(Delay);}combo FusionAA21 {set_val(PS4_RX,Power)wait(Delay);set_val(PS4_RY,Power)set_val(PS4_RX,-Power)wait(Delay);set_val(PS4_RY,-Power)}combo FusionAA22 {set_val(PS4_RX,-Power)set_val(PS4_RY,-Power)wait(Delay);set_val(PS4_RX,Power)set_val(PS4_RY,Power)wait(Delay);}combo FusionAA23 {set_val(PS4_RX,Power)wait(Delay);set_val(PS4_RY,Power)set_val(PS4_RX,-Power)wait(Delay);set_val(PS4_RY,-Power)}combo FusionAA24 {set_val(PS4_RX,-Power)set_val(PS4_RY,-Power)wait(Delay);set_val(PS4_RX,Power)set_val(PS4_RY,Power)wait(Delay);}combo FusionAA25 {set_val(PS4_RX,Power)wait(Delay);set_val(PS4_RY,Power)set_val(PS4_RX,-Power)wait(Delay);set_val(PS4_RY,-Power)}combo FusionAA26 {set_val(PS4_RX,-Power)set_val(PS4_RY,-Power)wait(Delay);set_val(PS4_RX,Power)set_val(PS4_RY,Power)wait(Delay);}combo FusionAA27 {set_val(PS4_RX,Power)wait(Delay);set_val(PS4_RY,Power)set_val(PS4_RX,-Power)wait(Delay);set_val(PS4_RY,-Power)}combo FusionAA28 {set_val(PS4_RX,-Power)set_val(PS4_RY,-Power)wait(Delay);set_val(PS4_RX,Power)set_val(PS4_RY,Power)wait(Delay);}combo FusionAA29 {set_val(PS4_RX,Power)wait(Delay);set_val(PS4_RY,Power)set_val(PS4_RX,-Power)wait(Delay);set_val(PS4_RY,-Power)}combo FusionAA30 {set_val(PS4_RX,-Power)set_val(PS4_RY,-Power)wait(Delay);set_val(PS4_RX,Power)set_val(PS4_RY,Power)wait(Delay);}combo FusionAA31 {set_val(XB1_RX,-Power)wait(Delay)set_val(XB1_RY,-Power) set_val(XB1_RX,Power)wait(Delay)set_val(XB1_RY,Power) DZ_AimBot()}combo FusionAA32 {set_val(XB1_RX,-Power)set_val(XB1_RY,-Power)wait(Delay)set_val(XB1_RX,-Power)set_val(XB1_RY,-Power)DZ_AimBot()}combo FusionAA33 {set_val(XB1_RX,-Power)wait(Delay)set_val(XB1_RY,-Power) set_val(XB1_RX,-0+Power) set_val(XB1_RY,-0+Power) DZ_AimBot()}combo FusionAA34 {set_val (XB1_RX,Power + 1)wait(Delay)set_val(XB1_RY,Power - 1)wait(Delay) }combo FusionAA35 {set_val (XB1_RY,Power - 1)wait(Delay)set_val(XB1_RX,Power + 1)wait(Delay)}combo FusionAA36 {set_val (XB1_RX,Power + 1)wait(Delay)set_val(XB1_RY,Power - 1)wait(Delay) } combo FusionAA37 {set_val (XB1_RY,Power - 1)wait(Delay)set_val(XB1_RX,Power + 1)wait(Delay)}combo FusionAA38 {set_val (XB1_RX,Power + 1)wait(Delay)set_val(XB1_RY,Power - 1)wait(Delay) }combo FusionAA39 {set_val (XB1_RY,Power - 1)wait(Delay)set_val(XB1_RX,Power + 1)wait(Delay) }combo KillSwitch { cls_oled(OLED_BLACK); if(KillSwitch){  print(center_x(get_misc_chars(6), OLED_FONT_SMALL_WIDTH),15,OLED_FONT_SMALL,OLED_WHITE,Misc[6]);print(center_x(get_misc_chars(7), OLED_FONT_SMALL_WIDTH),30,OLED_FONT_SMALL,OLED_WHITE,Misc[7]);}if(!KillSwitch){ print(center_x(get_misc_chars(6), OLED_FONT_SMALL_WIDTH),15,OLED_FONT_SMALL,OLED_WHITE,Misc[6]);print(center_x(get_misc_chars(8), OLED_FONT_SMALL_WIDTH),30,OLED_FONT_SMALL,OLED_WHITE,Misc[8]);} wait(1500);DisplayTitle = TRUE;} combo ToggleVibrate {if(Toggle)set_ledx(2, 2);set_rumble(RUMBLE_B, 50);wait(150);reset_rumble();wait(100);set_rumble(RUMBLE_B, 50);wait(150);reset_rumble();reset_leds();if(!Toggle) set_ledx(1, 1);set_rumble(RUMBLE_A, 50);wait(300);reset_rumble();wait(400);reset_leds();}combo RumbleOff {set_ledx(1, 1);set_rumble(RUMBLE_A, 50);wait(300);reset_rumble();wait(400);reset_leds();}
																																																																																			function MenuNavigation(f_modorval,f_min,f_max) { if(!get_val(PS4_L2)) {if(event_press(PS4_RIGHT)) {     f_modorval = cycle(f_modorval + 1, f_min , f_max  );DisplayMenu = TRUE;   }     if(event_press(PS4_LEFT)) {  f_modorval = cycle(f_modorval - 1, f_min , f_max  );DisplayMenu = TRUE;} set_val(PS4_RIGHT,0); set_val(PS4_LEFT,0); }if(ModMenu) {if(event_press(PS4_CIRCLE)) {    DisplayTitle = TRUE;ModMenu      = FALSE; DisplayMenu  = FALSE; combo_run(RumbleOff);     } set_val(PS4_CIRCLE,0); }return f_modorval; }function ToggleSwitch(f_name,f_val) { if(f_name) {       if(event_press(PS4_UP) || event_press(PS4_DOWN)) {f_val =! f_val;DisplayMenu = TRUE;       combo_run(ToggleVibrate); }Toggle = f_val;set_val(PS4_UP,0); set_val(PS4_DOWN,0); }return f_val;}function cycle(f_val, f_lo, f_hi) {if(f_val > f_hi) return f_lo;if(f_val < f_lo) return f_hi;return f_val;}function get_misc_chars(f_idx){if (Misc[f_idx + 1] != -1) return Misc[f_idx + 1] - Misc[f_idx] - 1;return sizeof(Misc) - Misc[f_idx];		}function get_modName_chars(f_idx) {if (ModNames[f_idx + 1] != -1) return ModNames[f_idx + 1] - ModNames[f_idx] - 1;return sizeof(ModNames) - ModNames[f_idx];		}function center_x(f_chars,f_font) {return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);}  function AntiRecoil() {if(get_val(PS4_RY) < 0)SmartAR = AntiRecoil_Strength + random(AntiRecoil_Prediction,AntiRecoil_Prediction * -1) / SmartAIDetection[0]if(get_val(PS4_RY) > 0)SmartAR = AntiRecoil_Strength + random(AntiRecoil_Prediction,AntiRecoil_Prediction * -1) / SmartAIDetection[0]}function Offset_AR(int Axis,Strength) {if(abs3(get_val(Axis)) < AntiRecoil_Strength)set_val(Axis,Strength)}   function set_value(int Axis,Strength) {if(abs3(get_val(Axis)) < 10)set_val(Axis,Strength)}function abs3(int Axis) {if(Axis < 0)Axis = clamp(abs(Axis),-100,100)return Axis;}function applyDeadzone() {correctStickInput(PS4_LX);	correctStickInput(PS4_LY);correctStickInput(PS4_RX);	correctStickInput(PS4_RY);}function correctStickInput(Stick) {stickThresholdLow  	= inv(DeadZoneCorrectionV);	stickThresholdHigh 	= DeadZoneCorrectionV;			stickValue			= get_val(Stick);	if((stickValue >= stickThresholdLow) && (stickValue <= stickThresholdHigh)){set_val(Stick, 0);}else if(stickValue < stickThresholdLow){set_val(Stick, clamp((stickValue - stickThresholdLow) - ((stickValue) * stickThresholdLow) / 100, inv(100), 100));}else if(stickValue > stickThresholdHigh){set_val(Stick, clamp((stickValue - stickThresholdHigh) + ((stickValue) * stickThresholdHigh) / 100, inv(100), 100));}else{set_val(Stick, 0);}}function SmartTargeting_Caculation() {if(get_val(PS4_RX) < 0)SmartX = SmartTargeting + (SmartSmoothing / SmartPrediction)Offset(PS4_RX,random(SmartX,SmartX * -1))if(get_val(PS4_RX) > 0)SmartX = SmartTargeting + (SmartSmoothing / SmartPrediction)Offset(PS4_RX,random(SmartX,SmartX * -1))if(get_val(PS4_RY) < 0)SmartY = SmartTargeting + (SmartSmoothing / SmartPrediction)Offset(PS4_RY,random(SmartY,SmartY * -1))if(get_val(PS4_RY) > 0)SmartY = SmartTargeting + (SmartSmoothing / SmartPrediction)Offset(PS4_RY,random(SmartY,SmartY * -1))}function SmartAim_Caculation() {SmartX2 = (SmartTargeting + SmartAim_Pull)SmartY2 = (SmartTargeting + SmartAim_Pull)Offset(PS4_RX,random(SmartX2,SmartX2 * -1))Offset(PS4_RY,random(SmartY2,SmartY2 * -1))}function Offset(int Axis,Strength) {set_val(Axis,abs(Axis) / 100 +  get_val(Axis) + Strength)}function DZ_AimBot(){if(XB1_RX + XB1_RY - XB1_LY + XB1_LX > 0)Power = -Power;if(XB1_RX + XB1_RY - XB1_LY + XB1_LX > -0)Power = Power;return;}function Xaim(int Varaible1,Varaible2) {Xaim5(Varaible1,Xaim3(Varaible1 ) * Xaim4(Xaim3(Varaible1))/ 100 + Xaim2(Varaible1,Varaible1 * -1) - Xaim2(Varaible2,Varaible2))return 0;}function Xaim1(int Varaible1,Varaible2) {Xaim5(Varaible1,Xaim3(Varaible1) * Xaim4(Xaim3(Varaible1)) / 100 + Xaim2(Varaible1,Varaible1) - Xaim2(Varaible2,Varaible2))return 0;}function Xaim2(int Varaible1,Varaible2) {Varaible1 = random(Varaible1, Varaible1 * -1)return Varaible1;}function Xaim3(int Varaible1)  {return get_val(Varaible1)}function Xaim4(int Varaible1){Varaible1 = abs( Varaible1)return Varaible1;}function Xaim5(int Varaible1,Varaible2) {set_val(Varaible1,Varaible2)}function Feature(int val1,val2){if(Initiate(Return(val1)) < 10) set_val(val1,val2) }function Initiate(int abs){if(abs < 0) abs = inv(abs) return abs;}function Return (int getvalue){getvalue = get_val(getvalue) return getvalue;}␀ú¹ºŠºŒºŠ½ÉþÌÿÇ