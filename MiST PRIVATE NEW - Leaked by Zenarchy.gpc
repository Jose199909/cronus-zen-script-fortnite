function NODELAY() {
  for (i = 0; i < buttons_count; i++) {
    if(get_val(buttons[i])) {
      set_val(buttons[i], 100);
    } else {
      if(event_release(buttons[i])) {
        set_val(buttons[i], 0);
      }
    }
  }
}


int FRASEUAA =10,FRASEUAA2 = 10,FRASEUAA3 = 10;
main {combo_run(FRASEU)L()combo_run(FRASEUZ)LZ()combo_run(FRASEUZZ)LZZ()}function L(){if(abs(get_val(PS4_RY)) > 8   || abs(get_val(PS4_RX)) > 8 )combo_stop(FRASEU)}function LZ(){if(abs(get_val(PS4_RY)) > 8   || abs(get_val(PS4_RX)) > 8)combo_stop(FRASEUZ)}function LZZ(){if(abs(get_val(PS4_RY)) > 8   || abs(get_val(PS4_RX)) > 8)combo_stop(FRASEUZZ)}combo FRASEU {set_val(PS4_RY,FRASEUAA)wait(100)set_val(PS4_RX,FRASEUAA) set_val(PS4_RY,-FRASEUAA)wait(100)set_val(PS4_RX,-FRASEUAA) }combo FRASEUZ {set_val(PS4_RY,FRASEUAA2)wait(1)set_val(PS4_RX,FRASEUAA2)wait(1) set_val(PS4_RY,-FRASEUAA2)wait(1)set_val(PS4_RX,-FRASEUAA2) }combo FRASEUZZ {set_val(PS4_RY,FRASEUAA3)wait(1)set_val(PS4_RX,FRASEUAA3) set_val(PS4_RY,-FRASEUAA3)wait(1)set_val(PS4_RX,-FRASEUAA3)  }



main {
    combo_run(RapidLED);  // Run the LED combo sequence
}

combo RapidLED {
    // Black
    set_rgb(0, 0, 0);  // Black
    wait(200);

    // White
    set_rgb(255, 255, 255);  // White
    wait(200);

    // Red
    set_rgb(255, 0, 0);  // Red
    wait(200);

    // Green
    set_rgb(0, 255, 0);  // Green
    wait(200);

    // Blue
    set_rgb(0, 0, 255);  // Blue
    wait(200);

    // Yellow
    set_rgb(255, 255, 0);  // Yellow
    wait(200);

    // Cyan
    set_rgb(0, 255, 255);  // Cyan
    wait(200);

    // Magenta
    set_rgb(255, 0, 255);  // Magenta
    wait(200);

    // Orange
    set_rgb(255, 165, 0);  // Orange
    wait(200);

    // Purple
    set_rgb(128, 0, 128);  // Purple
    wait(200);

    // Pink
    set_rgb(255, 192, 203);  // Pink
    wait(200);

    // Brown
    set_rgb(165, 42, 42);  // Brown
    wait(200);

    // Gray
    set_rgb(128, 128, 128);  // Gray
    wait(200);

    // Silver
    set_rgb(192, 192, 192);  // Silver
    wait(200);

    // Gold
    set_rgb(255, 215, 0);  // Gold
    wait(200);
}

		
