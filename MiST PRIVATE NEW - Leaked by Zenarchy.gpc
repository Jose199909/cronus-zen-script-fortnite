combo aimAssist {

    set_val(aimY,get_ival(aimY) + inv(strenght));
    wait(delayMs):
    set_val(aimX,get_ival(aimX) + strenght);
    wait(delayMs):
    set_val(aimY,get_ival(aimY) + strenght);
    wait(delayMs):
    set_val(aimX,get_ival(aimX) + inv(strenght));
    wait(delayMs):
}




