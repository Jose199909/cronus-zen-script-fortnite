            }
        }
        
        // Page 18: Turbo Edit (toggle only)
        if(page == 18) {
            print(4, 28, OLED_FONT_MEDIUM, OLED_WHITE, onOff[toggle_turbo_edit]);
            draw_toggle_pill(96, 26, toggle_turbo_edit);
            if(event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(XB1_UP) || event_press(XB1_DOWN)) {
                toggle_turbo_edit = !toggle_turbo_edit;
                flashtoggle = toggle_turbo_edit;
                combo_run(vibration_valchg);
                UPDATE_LED_FOR_MOD_STATE(toggle_turbo_edit);
            }
        }
        
        // Page 19: Beam (toggle only - includes aim shake, radar, and headlock)
        if(page == 19) {
            print(4, 28, OLED_FONT_MEDIUM, OLED_WHITE, onOff[toggle_beam]);
            draw_toggle_pill(96, 26, toggle_beam);
            if(event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(XB1_UP) || event_press(XB1_DOWN)) {
                toggle_beam = !toggle_beam;
                flashtoggle = toggle_beam;
                combo_run(vibration_valchg);
                UPDATE_LED_FOR_MOD_STATE(toggle_beam);
            }
        }
        
        // Bottom divider and page dots (Hoops style)
        line_oled(0, 50, 127, 50, 1, OLED_WHITE);
        draw_page_dots(page, numpgs + 1);
        
        if(page > numpgs) { page = numpgs; }
        if(page < 0) { page = 0; }
    } else {
        // ===== ARC MOD EXECUTION (when menu is closed) =====
        
        // Instant Reset Macro
        if(toggle_insta_reset) {
            if(event_press(BTN_INSTANT_RESET)) {
                combo_run(ComboInstantReset);
            }
        }
        
        // Auto Tracking
        if(toggle_auto_tracking) {
            if(abs(get_ival(AXIS_LX)) <= 35 && abs(get_ival(AXIS_LY)) <= 35) {
                combo_run(ComboAutoTracking);
            } else {
                combo_stop(ComboAutoTracking);
            }
        }
        
        // Anti-Recoil
        if(toggle_anti_recoil) {
            ApplyAntiRecoil();
        }
        
        // Anti-Bloom
        if(toggle_anti_bloom) {
            right_stick_magnitude = isqrt(pow(get_ival(XB1_RX), 2) + pow(get_ival(XB1_RY), 2));
            left_stick_magnitude = isqrt(pow(get_ival(XB1_LX), 2) + pow(get_ival(XB1_LY), 2));
            
            if(get_val(BTN_FIRE)) {
                if(right_stick_magnitude <= (right_zone + 3)) {
                    bloom_angle = (bloom_angle + 30) % 360;
                    SetPolarMovement(POLAR_RS, polar_angle, ((right_zone + 5/2) * 360));
                }
                if(left_stick_magnitude <= (left_zone + 3)) {
                    polar_angle = (polar_angle + 21) % 360;
                    SetPolarMovement(POLAR_LS, polar_angle, ((left_zone + 60) * 360));
                }
            }
            
            if(right_stick_magnitude <= right_zone) {
                bloom_angle = (bloom_angle + 18) % 360;
                SetPolarMovement(POLAR_RS, bloom_angle, (right_zone + 3 * 360));
            }
        }
        
        // Pickup Macro
        if(toggle_pickup_macro) {
            if(get_val(BTN_INTERACT) && get_val(XB1_RB)) {
                combo_run(ComboPickupMacro);
            }
        }
        if(event_release(BTN_INTERACT)) {
            combo_stop(ComboPickupMacro);
        }
        if(get_val(BTN_ADS)) {
            combo_stop(ComboPickupMacro);
        }
        
        // No Delay
        if(toggle_no_delay) {
            vm_tctrl(-8);
        } else {
            vm_tctrl(-4);
        }
        
        // Pre-Fire
        if(toggle_pre_fire) {
            if(get_val(BTN_INTERACT) && get_val(BTN_FIRE)) {
                combo_run(ComboPreFire);
            }
        }
        
        // Aim Abuse
        if(toggle_aim_abuse) {
            if(get_val(BTN_ADS) > 95) {
                combo_run(ComboAimAbuse);
            }
            if(event_release(BTN_ADS)) {
                combo_stop(ComboAimAbuse);
            }
        }
        
        // Pro (Polar Movement / Aim Assist)
        // Vertically stretched figure-8 pattern - optimized for Fortnite
        if(toggle_pro) {
            actual_x = get_val(AXIS_RX);
            actual_y = get_val(AXIS_RY);
            actual_magnitude = isqrt(pow(actual_x, 2) + pow(actual_y, 2));
            max_magnitude = (actual_magnitude < 100);
            
            if(!(time_counter++ % step_interval)) {
                angle += steps;
            }
            angle = angle % 360;
            
            sin_angle = POLAR_ARRAY[angle % 360];
            cos_angle = POLAR_ARRAY[(angle * 2) % 360];
            cos_angle = (cos_angle * power_polar) / 350;  // Minimal X movement
            sin_angle = (sin_angle * power_polar) / 80;   // Strong Y movement (4:1 ratio)
            
            if(get_val(BTN_ADS) || get_val(BTN_FIRE)) {
                if(actual_magnitude <= power_polar) {
                    sin_angle -= actual_y;
                    cos_angle -= actual_x;
                } else {
                    sin_angle = (sin_angle * (200 - ((abs(actual_y) + actual_magnitude) / 10) * 10) / 200) * max_magnitude;
                    cos_angle = (cos_angle * (200 - ((abs(actual_x) + actual_magnitude) / 10) * 10) / 200) * max_magnitude;
                }
                set_val(AXIS_RX, clamp(actual_x + cos_angle, -100, 100));
                set_val(AXIS_RY, clamp(actual_y + sin_angle, -100, 100));
            }
        }
        
        // Enhancement (Aim Assist)
        if(toggle_enhancement) {
            if(get_val(BTN_ADS) > 50) {
                if(abs(get_val(XB1_RX)) < power_enhancement)
                if(abs(get_val(XB1_RY)) < power_enhancement)
                if(abs(get_val(XB1_RX)) > -power_enhancement)
                if(abs(get_val(XB1_RY)) > -power_enhancement) {
                    polar_flow_x = CalculatePolarFlow(polar_flow_x, POLAR_X_START, POLAR_X_END, POLAR_VELOCITY_START, polar_flow_direction, 1);
                    polar_flow_y = CalculatePolarFlow(polar_flow_y, POLAR_Y_START, POLAR_Y_END, POLAR_VELOCITY_START, polar_flow_prev_direction, 2);
                    SetPolarMovement(POLAR_RS, 45, polar_flow_x);  // Changed from 30 to 45 degrees for different shape
                    SetPolarMovement(POLAR_RS, 45, polar_flow_y);  // Changed from 30 to 45 degrees for different shape
                }
            }
            
            if(event_press(BTN_ADS)) {
                powers_active = TRUE;
            } else if(!get_ival(BTN_ADS) && event_press(BTN_FIRE)) {
                powers_active = TRUE;
            }
            
            if(get_ival(BTN_ADS) || get_ival(BTN_FIRE)) {
                axis_xy = isqrt(abs(get_ival(AXIS_RX)) * abs(get_ival(AXIS_RX)) + abs(get_ival(AXIS_RY)) * abs(get_ival(AXIS_RY)));
                
                if(assist_profile == 1) {
                    ApplyAimAssist(power_enhancement, power_enhancement);
                }
                
                ApplySoftAimAssist();
            } else {
                count_power = 0;
                power_toggle = FALSE;
            }
            
            if(!get_ival(BTN_ADS) && !get_ival(BTN_FIRE)) {
                aim_assist_timer = 0;
                axis_mode = 0;
            }
            
            combo_run(ComboControllerPrecision);
        }
        
        // Rapid Fire
        if(toggle_rapid_fire) {
            if(get_val(BTN_FIRE)) {
                combo_run(ComboRapidFire);
            }
        }
        
        // Radar (controlled by Beam toggle)
        if(toggle_beam) {
            if(abs(get_val(AXIS_LX)) < 35 && abs(get_val(AXIS_LY)) < 35) {
                radar_angle = (radar_angle + speed_radar) % 360;
                radar_x = (radius_radar * POLAR_ARRAY[radar_angle]) / 100;
                radar_y = (radius_radar * POLAR_ARRAY[(radar_angle + 90) % 360]) / 100;
                set_val(AXIS_LX, clamp(radar_x, -100, 100));
                set_val(AXIS_LY, clamp(radar_y, -100, 100));
            }
        }
        
        // Turbo Edit
        if(toggle_turbo_edit) {
            if(get_val(BTN_EDIT)) {
                combo_run(ComboEdit);
            }
        }
        
        // No Vibration
        if(toggle_no_vibration) {
            block_rumble();
        }
        
        // Crouch Shot
        if(toggle_crouch_shot) {
            if(get_val(BTN_FIRE) && get_val(BTN_ADS)) {
                combo_run(ComboCrouchShot);
            }
        }
        
        // Beam (Aim Shake)
        if(toggle_beam) {
            beam_current_rx = get_val(PS4_RX);
            beam_previous_rx = get_lval(PS4_RX);
            beam_current_ry = get_val(PS4_RY);
            beam_previous_ry = get_lval(PS4_RY);
            
            beam_delta_rx = beam_current_rx - beam_previous_rx;
            beam_delta_ry = beam_current_ry - beam_previous_ry;
            
            beam_shake_amplitude_x = CalculateBeamShake(beam_current_rx, beam_previous_rx, 10);
            beam_shake_amplitude_y = CalculateBeamShake(beam_current_ry, beam_previous_ry, 10);
            
            if(beam_delta_rx > 0) 
                beam_direction_bias_x = 1;
            else if(beam_delta_rx < 0) 
                beam_direction_bias_x = -1;
            else 
                beam_direction_bias_x = 0;
            
            if(beam_delta_ry > 0) 
                beam_direction_bias_y = 1;
            else if(beam_delta_ry < 0) 
                beam_direction_bias_y = -1;
            else 
                beam_direction_bias_y = 0;
            
            beam_shake_x = (random(-beam_shake_amplitude_x, beam_shake_amplitude_x) * 6) / 10
                          + (beam_direction_bias_x * BEAM_SHAKE_PARAMS[2][2]);
            beam_shake_y = (random(-beam_shake_amplitude_y, beam_shake_amplitude_y) * 6) / 10
                          + (beam_direction_bias_y * BEAM_SHAKE_PARAMS[2][2]);
            
            beam_adjusted_rx = clamp(beam_current_rx + beam_shake_x, -100, 100);
            beam_adjusted_ry = clamp(beam_current_ry + beam_shake_y, -100, 100);
            
            set_val(PS4_RX, beam_adjusted_rx);
            set_val(PS4_RY, beam_adjusted_ry);
        }
        
        // Headlock (controlled by Beam toggle)
        if(toggle_beam) {
            combo_run(ComboHeadlock);
        }
    }
}

// ===== COMBO DEFINITIONS =====
combo ComboPickupMacro {
    set_val(BTN_INTERACT, 100);
    wait(10);
    set_val(BTN_INTERACT, 0);
}

combo ComboAntiRecoilApply {
    adjust_anti_recoil = get_ival(PS4_RY) + power_anti_recoil;
    if(adjust_anti_recoil > 100) {
        adjust_anti_recoil = 100;
    }
    set_val(PS4_RY, adjust_anti_recoil);
}

combo RumbleActivate {
    set_rgb(10, 0, 100);
    set_rumble(RUMBLE_B, 50);
    wait(150);
    reset_rumble();
    wait(100);
    set_rumble(RUMBLE_B, 50);
    wait(150);
    reset_rumble();
}

combo RumbleDeactivate {
    set_rgb(255, 0, 0);
    set_rumble(RUMBLE_A, 50);
    wait(300);
    reset_rumble();
    wait(400);
}

combo ComboSavedMessage {
    combo_run(RumbleActivate);
    wait(150);
    combo_run(RumbleActivate);
    wait(1000);
    set_rgb(10, 0, 100);
    combo_run(ShowLogo);
}

combo ComboCrouchShot {
    set_val(BTN_CROUCH, 100);
    wait(delay_crouch_shot);
    set_val(BTN_CROUCH, 0);
    wait(delay_crouch_shot);
}

combo ComboAutoTracking {
    set_val(AXIS_LX, -power_auto_tracking);
    wait(1);
    set_val(AXIS_LX, power_auto_tracking);
}

combo ComboPreFire {
    set_val(BTN_FIRE, 0);
}

combo ComboRapidFire {
    wait(40);
    set_val(BTN_FIRE, 0);
    wait(40);
}

combo ShowLogo {
    image_oled(0, 0, TRUE, TRUE, LOGO[0]);
}

combo ComboInstantReset {
    set_val(BTN_EDIT, 100);
    wait(11);
    set_val(BTN_RESET, 100);
    wait(11);
    combo_run(ComboConfirm);
}

combo ComboEdit {
    set_val(BTN_EDIT, 100);
    wait(35);
    set_val(BTN_SELECT, 100);
    wait(35);
    set_val(BTN_CONFIRM, 100);
    wait(35);
    set_val(BTN_EDIT, 0);
    wait(35);
}

combo ComboConfirm {
    set_val(BTN_CONFIRM, 100);
    wait(11);
    set_val(BTN_CONFIRM, 0);
    wait(11);
}

combo ComboAimAbuse {
    set_val(BTN_ADS, 100);
    wait(60);
    set_val(BTN_ADS, 0);
    wait(5);
}

combo ComboControllerPrecision {
    // Diamond pattern instead of square (diagonal movements)
    set_val(PS4_RY, get_ival(PS4_RY) + power_enhancement);
    set_val(PS4_RX, get_ival(PS4_RX) + power_enhancement);
    wait(20);
    set_val(PS4_RY, get_ival(PS4_RY) + power_enhancement * -1);
    set_val(PS4_RX, get_ival(PS4_RX) + power_enhancement);
    wait(20);
    set_val(PS4_RY, get_ival(PS4_RY) + power_enhancement * -1);
    set_val(PS4_RX, get_ival(PS4_RX) + power_enhancement * -1);
    wait(20);
    set_val(PS4_RY, get_ival(PS4_RY) + power_enhancement);
    set_val(PS4_RX, get_ival(PS4_RX) + power_enhancement * -1);
    wait(20);
}

combo ComboHeadlock {
    ApplyAxisMultiplier(XB1_RY, -3);
}

// ===== FUNCTION DEFINITIONS =====
function ApplyAntiRecoil() {
    if(get_val(BTN_FIRE) && get_val(BTN_ADS)) {
        combo_run(ComboAntiRecoilApply);
    }
    if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > power_anti_recoil) {
        combo_stop(ComboAntiRecoilApply);
    }
    return;
}

function SetAxisValue(axis, target_value) {
    if(CalculateAbsoluteValue(GetAxisValue(axis)) < 10)
        set_val(axis, target_value);
}

function CalculateAbsoluteValue(value) {
    if(value < 0) value = inv(value);
    return value;
}

function GetAxisValue(axis) {
    axis = get_val(axis);
    return axis;
}

function ApplySoftAimAssist() {
    aim_assist_timer += get_rtime();
    
    if(!axis_mode)
        SetAxisValue(AXIS_RY, aim_assist_timer * SOFT_AIM_POWER / 10);
    if(axis_mode == 1)
        SetAxisValue(AXIS_RX, aim_assist_timer * SOFT_AIM_POWER / 10);
    if(axis_mode == 2)
        SetAxisValue(AXIS_RY, inv(aim_assist_timer * SOFT_AIM_POWER / 10));
    if(axis_mode == 3) {
        SetAxisValue(AXIS_RX, inv(aim_assist_timer * SOFT_AIM_POWER / 10));
        if(aim_assist_timer > 50) {
            aim_assist_timer = 0;
            axis_mode = 0;
        }
    } else if(aim_assist_timer > 50) {
        aim_assist_timer = 0;
        axis_mode += 1;
    }
}

function CalculatePolarFlow(flow_val, start_val, end_val, velocity, direction, velocity_id) {
    if(direction) {
        flow_val += velocity;
        if(flow_val <= end_val)
            return flow_val;
        if(flow_val > end_val) {
            polar_flow_direction = 0;
            return flow_val - velocity;
        }
    } else {
        flow_val -= velocity;
        if(flow_val >= start_val)
            return flow_val;
        if(flow_val < start_val) {
            polar_flow_direction = 1;
            return flow_val + velocity;
        }
    }
    return FALSE;
}

function ApplyAimAssist(strength, step) {
    if(powers_active) {
        y_power = strength;
        x_power = strength * -1;
        increment = step;
        powers_active = FALSE;
    }
    
    if(!power_toggle) {
        x_power += increment;
        y_power -= increment;
    } else {
        x_power -= increment;
        y_power += increment;
    }
    
    count_power++;
    
    if(count_power >= (strength / increment)) {
        power_toggle = !power_toggle;
        count_power = 0;
    }
    
    if(axis_xy > power_enhancement) {
        if(reducer) {
            set_val(AXIS_RY, (y_power - strength / 2));
            set_val(AXIS_RX, (x_power - strength / 2 * -1));
        } else {
            set_val(AXIS_RY, (y_power - strength / 2) + get_ival(AXIS_RY));
            set_val(AXIS_RX, (x_power - strength / 3 * -2) + get_ival(AXIS_RX));
        }
    } else {
        if(reducer) {
            set_val(AXIS_RY, (y_power - strength / 2));
            set_val(AXIS_RX, (x_power - strength / 3 * -2));
        } else {
            set_val(AXIS_RY, (y_power - strength / 2));
            set_val(AXIS_RX, (x_power - strength / 3 * -2));
        }
    }
}

function AdjustAxisValue(axis, multiplier) {
    set_val(axis, clamp(multiplier * (100 - abs(get_val(axis))) / 100 + get_val(axis), -100, 100));
    return;
}

function SetPolarMovement(polar_axis, angle_val, magnitude_val) {
    right_stick_y_reference = 9 + polar_axis;
    right_stick_x_reference = 10 + polar_axis;
    
    if(angle_val < 0) angle_val = 360 + (angle_val % 360);
    angle_val = (angle_val + 90) % 360;
    magnitude_val = clamp(magnitude_val, 0, 100);
    
    cosine_value = POLAR_ARRAY[angle_val];
    sine_value = POLAR_ARRAY[(angle_val + 90) % 360];
    
    AdjustAxisValue(right_stick_y_reference, inv(magnitude_val * sine_value / 100));
    AdjustAxisValue(right_stick_x_reference, inv(magnitude_val * cosine_value / 100));
}

function CalculateBeamShake(current_val, previous_val, threshold) {
    beam_delta = abs(current_val - previous_val);
    
    if(beam_delta < threshold) {
        beam_intensity = BEAM_SHAKE_PARAMS[0][0];
    } else if(beam_delta < threshold * 2) {
        beam_intensity = BEAM_SHAKE_PARAMS[1][0];
    } else {
        beam_intensity = BEAM_SHAKE_PARAMS[2][0];
    }
    
    return beam_intensity;
}

function ApplyAxisMultiplier(axis, multiplier) {
    set_val(axis, clamp(multiplier * (100 - abs(get_val(axis))) / 100 + get_val(axis), -100, 100));
    return;
}

// ============================================================================
// END OF SCRIPT
