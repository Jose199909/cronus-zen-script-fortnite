                    setting_jitter_activation_ads = FALSE;
                    setting_jitter_activation_ads_fire = FALSE;
                }
            }
            else if (jitter_activation_menu_selection == 4) {
                current_menu_level = JITTER_AIM_CONFIG_LEVEL;
            }
        }
    }
}

function apply_jitter_aim() {
    if (jitter_active_condition) {
        if (abs(raw_rx) < 25 && abs(raw_ry_stick) < 25) {
            jitter_timer += get_rtime();
            if (jitter_timer >= 20) {
                jitter_timer = 0;
                jitter_direction = !jitter_direction;
            }
            jitter_val = setting_jitter_aim_strength;
            if (jitter_direction) {
                final_rx = clamp(final_rx + jitter_val, -100, 100);
                final_ry = clamp(final_ry - jitter_val, -100, 100);
            } else {
                final_rx = clamp(final_rx - jitter_val, -100, 100);
                final_ry = clamp(final_ry + jitter_val, -100, 100);
            }
        }
    }
}

function apply_corrective_aim() {
    if (setting_corrective_aim_toggle && get_val(BUTTON_ADS_GAME)) {
        corrective_current_x = final_rx;
        corrective_current_y = final_ry;
        if (abs(corrective_current_x) < 7 && abs(corrective_current_y) < 7) {
            corrective_oscillate_direction = !corrective_oscillate_direction;
            corrective_min_input = 7;
            if (corrective_oscillate_direction) {
                corrective_current_x += corrective_min_input;
                corrective_current_y += corrective_min_input;
            } else {
                corrective_current_x -= corrective_min_input;
                corrective_current_y -= corrective_min_input;
            }
        }
        corrective_current_x = corrective_current_x + (corrective_current_x * setting_corrective_aim_strength / 100);
        corrective_current_y = corrective_current_y + (corrective_current_y * setting_corrective_aim_strength / 100);
        corrective_current_x = (corrective_current_x * (100 - setting_corrective_aim_smoothing) + corrective_previous_x * setting_corrective_aim_smoothing) / 100;
        corrective_current_y = (corrective_current_y * (100 - setting_corrective_aim_smoothing) + corrective_previous_y * setting_corrective_aim_smoothing) / 100;
        corrective_previous_x = corrective_current_x;
        corrective_previous_y = corrective_current_y;
        final_rx = clamp(corrective_current_x, -100, 100);
        final_ry = clamp(corrective_current_y, -100, 100);
    }
}

init {
    setting_anti_recoil_toggle = get_pvar(SPVAR_1, 0, 1, TRUE);
    setting_recoil_vertical = get_pvar(SPVAR_2, 0, 99, 15);
    setting_ads_sticky_aim_toggle = get_pvar(SPVAR_3, 0, 1, TRUE);
    setting_ads_sticky_aim_strength = get_pvar(SPVAR_4, 0, 100, 20);
    setting_aim_drag_toggle = get_pvar(SPVAR_5, 0, 1, TRUE);
    setting_aim_drag_strength = get_pvar(SPVAR_6, 0, 30, 2);
    setting_aim_drag_threshold = get_pvar(SPVAR_7, 0, 50, 10);
    setting_polar_aim_toggle = get_pvar(SPVAR_8, 0, 1, TRUE);
    setting_polar_aim_radius = get_pvar(SPVAR_9, 0, 100, 10);
    setting_polar_aim_speed = get_pvar(SPVAR_10, 0, 100, 30);
    setting_left_stick_deadzone = get_pvar(SPVAR_11, 0, 100, 5);
    setting_right_stick_deadzone = get_pvar(SPVAR_12, 0, 100, 5);
    setting_aimlock_toggle = get_pvar(SPVAR_13, 0, 1, FALSE);
    setting_aimlock_strength = get_pvar(SPVAR_14, 0, 100, 75);
    setting_fast_pickup_toggle = get_pvar(SPVAR_15, 0, 1, FALSE);
    setting_recoil_horizontal = get_pvar(SPVAR_16, -99, 99, 0);
    setting_jitter_aim_toggle = get_pvar(SPVAR_17, 0, 1, FALSE);
    setting_jitter_aim_strength = get_pvar(SPVAR_18, 0, 30, 8);
    setting_corrective_aim_toggle = get_pvar(SPVAR_19, 0, 1, FALSE);
    setting_corrective_aim_strength = get_pvar(SPVAR_20, 0, 100, 15);
    setting_corrective_aim_smoothing = get_pvar(SPVAR_21, 0, 99, 20);
    setting_polar_activation_idle = get_pvar(SPVAR_22, 0, 1, FALSE);
    setting_polar_activation_ads = get_pvar(SPVAR_23, 0, 1, FALSE);
    setting_polar_activation_ads_fire = get_pvar(SPVAR_24, 0, 1, FALSE);
    setting_polar_activation_always = get_pvar(SPVAR_25, 0, 1, TRUE);
    setting_strafe_activation_idle = get_pvar(SPVAR_26, 0, 1, FALSE);
    setting_strafe_activation_ads = get_pvar(SPVAR_27, 0, 1, FALSE);
    setting_strafe_activation_ads_fire = get_pvar(SPVAR_28, 0, 1, TRUE);
    setting_strafe_activation_always = get_pvar(SPVAR_29, 0, 1, FALSE);
    setting_jitter_activation_idle = get_pvar(SPVAR_30, 0, 1, FALSE);
    setting_jitter_activation_ads = get_pvar(SPVAR_31, 0, 1, TRUE);
    setting_jitter_activation_ads_fire = get_pvar(SPVAR_32, 0, 1, FALSE);
    setting_jitter_activation_always = get_pvar(SPVAR_33, 0, 1, FALSE);
    
    spammable_buttons[0] = PS4_SQUARE;
    spammable_buttons[1] = PS4_CROSS;
    spammable_buttons[2] = PS4_CIRCLE;
    spammable_buttons[3] = PS4_TRIANGLE;
    spammable_buttons[4] = PS4_UP;
    spammable_buttons[5] = PS4_DOWN;
    spammable_buttons[6] = PS4_LEFT;
    spammable_buttons[7] = PS4_RIGHT;
    spammable_buttons[8] = PS4_L2;
    spammable_buttons[9] = PS4_R2;
    spammable_buttons[10] = PS4_L3;
    spammable_buttons[11] = PS4_R3;
    
    strafe_timer_cycles = STRAFE_INTERVAL_CYCLES;

    corrective_previous_x = 0;
    corrective_previous_y = 0;
    corrective_oscillate_direction = 0;
    jitter_timer = 0;
    jitter_direction = 0;
    jitter_val = 0;
    corrective_current_x = 0;
    corrective_current_y = 0;
    corrective_min_input = 0;
}

main {
    if (get_val(BUTTON_MENU_1) && event_press(BUTTON_MENU_2)) {
        menu_active = !menu_active;
        if (!menu_active) {
            show_image_on_exit = TRUE;
            image_display_timer = 0;
            set_pvar(SPVAR_1, setting_anti_recoil_toggle);
            set_pvar(SPVAR_2, setting_recoil_vertical);
            set_pvar(SPVAR_3, setting_ads_sticky_aim_toggle);
            set_pvar(SPVAR_4, setting_ads_sticky_aim_strength);
            set_pvar(SPVAR_5, setting_aim_drag_toggle);
            set_pvar(SPVAR_6, setting_aim_drag_strength);
            set_pvar(SPVAR_7, setting_aim_drag_threshold);
            set_pvar(SPVAR_8, setting_polar_aim_toggle);
            set_pvar(SPVAR_9, setting_polar_aim_radius);
            set_pvar(SPVAR_10, setting_polar_aim_speed);
            set_pvar(SPVAR_11, setting_left_stick_deadzone);
            set_pvar(SPVAR_12, setting_right_stick_deadzone);
            set_pvar(SPVAR_13, setting_aimlock_toggle);
            set_pvar(SPVAR_14, setting_aimlock_strength);
            set_pvar(SPVAR_15, setting_fast_pickup_toggle);
            set_pvar(SPVAR_16, setting_recoil_horizontal);
            set_pvar(SPVAR_17, setting_jitter_aim_toggle);
            set_pvar(SPVAR_18, setting_jitter_aim_strength);
            set_pvar(SPVAR_19, setting_corrective_aim_toggle);
            set_pvar(SPVAR_20, setting_corrective_aim_strength);
            set_pvar(SPVAR_21, setting_corrective_aim_smoothing);
            set_pvar(SPVAR_22, setting_polar_activation_idle);
            set_pvar(SPVAR_23, setting_polar_activation_ads);
            set_pvar(SPVAR_24, setting_polar_activation_ads_fire);
            set_pvar(SPVAR_25, setting_polar_activation_always);
            set_pvar(SPVAR_26, setting_strafe_activation_idle);
            set_pvar(SPVAR_27, setting_strafe_activation_ads);
            set_pvar(SPVAR_28, setting_strafe_activation_ads_fire);
            set_pvar(SPVAR_29, setting_strafe_activation_always);
            set_pvar(SPVAR_30, setting_jitter_activation_idle);
            set_pvar(SPVAR_31, setting_jitter_activation_ads);
            set_pvar(SPVAR_32, setting_jitter_activation_ads_fire);
            set_pvar(SPVAR_33, setting_jitter_activation_always);
            cls_oled(0);
        }
    }

    if (menu_active) {
        suppress_all_inputs();
        handle_menu_input();
        if (menu_active) {
            draw_oled_menu();
        }
    } else {
        if (show_image_on_exit) {
            combo_run(oled);
            image_display_timer += get_rtime();
            if (image_display_timer >= 15000) {
                show_image_on_exit = FALSE;
                cls_oled(0);
            }
        }
        
        raw_lx = get_val(PS4_LX);
        raw_ly = get_val(PS4_LY);
        raw_rx = get_val(PS4_RX);
        raw_ry_stick = get_val(PS4_RY);

        final_lx = raw_lx;
        final_ly = raw_ly;
        final_rx = raw_rx;
        final_ry = raw_ry_stick;

        if (abs(raw_lx) < setting_left_stick_deadzone) final_lx = 0;
        if (abs(raw_ly) < setting_left_stick_deadzone) final_ly = 0;
        if (abs(raw_rx) < setting_right_stick_deadzone) final_rx = 0;
        if (abs(raw_ry_stick) < setting_right_stick_deadzone) final_ry = 0;
        
        strafe_active_condition = FALSE;
        if (setting_strafe_toggle) {
            if (setting_strafe_activation_always) strafe_active_condition = TRUE;
            if (setting_strafe_activation_idle && !get_val(BUTTON_ADS_GAME) && !get_val(BUTTON_FIRE_GAME)) strafe_active_condition = TRUE;
            if (setting_strafe_activation_ads && get_val(BUTTON_ADS_GAME)) strafe_active_condition = TRUE;
            if (setting_strafe_activation_ads_fire && get_val(BUTTON_ADS_GAME) && get_val(BUTTON_FIRE_GAME)) strafe_active_condition = TRUE;
        }

        if (strafe_active_condition) {
            if (abs(raw_lx) < setting_left_stick_deadzone) {
                strafe_timer_cycles = strafe_timer_cycles - 1;
                if (strafe_timer_cycles <= 0) {
                    strafe_direction_flag = !strafe_direction_flag;
                    strafe_timer_cycles = STRAFE_INTERVAL_CYCLES;
                }
                if (strafe_direction_flag == 0) {
                    final_lx = -100;
                } else {
                    final_lx = 100;
                }
            }
        }

        detected_button_this_cycle_fp = 0;
        if (setting_fast_pickup_toggle && get_val(PS4_L1) && get_val(PS4_R1)) {
            for (g_fp_loop_idx = 0; g_fp_loop_idx < 12; g_fp_loop_idx++) {
                if (get_val(spammable_buttons[g_fp_loop_idx])) {
                    if (spammable_buttons[g_fp_loop_idx] != PS4_L1 && spammable_buttons[g_fp_loop_idx] != PS4_R1) {
                        detected_button_this_cycle_fp = spammable_buttons[g_fp_loop_idx];
                        break;
                    }
                }
            }
        }

        if (button_being_spammed != detected_button_this_cycle_fp) {
            if (button_being_spammed != 0) {
                set_val(button_being_spammed, 0);
            }
            button_being_spammed = detected_button_this_cycle_fp;
            fast_pickup_spam_state = 0;
            fast_pickup_timer = 0;
        }

        if (button_being_spammed != 0) {
            fast_pickup_timer += get_rtime();
            if (fast_pickup_spam_state == 0) {
                if (fast_pickup_timer >= setting_fast_pickup_release_time) {
                    set_val(button_being_spammed, 100);
                    fast_pickup_spam_state = 1;
                    fast_pickup_timer = 0;
                }
            } else {
                if (fast_pickup_timer >= setting_fast_pickup_press_time) {
                    set_val(button_being_spammed, 0);
                    fast_pickup_spam_state = 0;
                    fast_pickup_timer = 0;
                }
            }
        } else {
            if (fast_pickup_spam_state == 1 && button_being_spammed != 0) {
                 set_val(button_being_spammed, 0);
            }
            fast_pickup_spam_state = 0;
            fast_pickup_timer = 0;
            button_being_spammed = 0;
        }

        apply_corrective_aim();
        
        jitter_active_condition = FALSE;
        if (setting_jitter_aim_toggle) {
            if (setting_jitter_activation_always) jitter_active_condition = TRUE;
            if (setting_jitter_activation_idle && !get_val(BUTTON_ADS_GAME) && !get_val(BUTTON_FIRE_GAME)) jitter_active_condition = TRUE;
            if (setting_jitter_activation_ads && get_val(BUTTON_ADS_GAME)) jitter_active_condition = TRUE;
            if (setting_jitter_activation_ads_fire && get_val(BUTTON_ADS_GAME) && get_val(BUTTON_FIRE_GAME)) jitter_active_condition = TRUE;
        }
        apply_jitter_aim();
        
        if (setting_ads_sticky_aim_toggle && get_val(BUTTON_ADS_GAME)) {
            final_rx = (final_rx * (100 - setting_ads_sticky_aim_strength)) / 100;
            final_ry = (final_ry * (100 - setting_ads_sticky_aim_strength)) / 100;
        }

        if (setting_aim_drag_toggle && get_val(BUTTON_ADS_GAME)) {
            if (abs(final_rx) > setting_aim_drag_threshold) {
                if (final_rx > 0) final_rx = clamp(final_rx + setting_aim_drag_strength, -100, 100);
                else if (final_rx < 0) final_rx = clamp(final_rx - setting_aim_drag_strength, -100, 100);
            }
            if (abs(final_ry) > setting_aim_drag_threshold) {
                if (final_ry > 0) final_ry = clamp(final_ry + setting_aim_drag_strength, -100, 100);
                else if (final_ry < 0) final_ry = clamp(final_ry - setting_aim_drag_strength, -100, 100);
            }
        }

        if (setting_polar_aim_toggle) {
            polar_aim_active_condition = FALSE;
            if (setting_polar_activation_always) polar_aim_active_condition = TRUE;
            if (setting_polar_activation_idle && !get_val(BUTTON_ADS_GAME) && !get_val(BUTTON_FIRE_GAME)) polar_aim_active_condition = TRUE;
            if (setting_polar_activation_ads && get_val(BUTTON_ADS_GAME)) polar_aim_active_condition = TRUE;
            if (setting_polar_activation_ads_fire && get_val(BUTTON_ADS_GAME) && get_val(BUTTON_FIRE_GAME)) polar_aim_active_condition = TRUE;

            if (polar_aim_active_condition) {
                stick_magnitude = isqrt(pow(final_rx, 2) + pow(final_ry, 2));
                
                polar_angle_accumulator += setting_polar_aim_speed;
                polar_angle_accumulator = polar_angle_accumulator % 360;

                sin_val = POLAR_ASSIST_DATA[polar_angle_accumulator];
                cos_val = POLAR_ASSIST_DATA[(polar_angle_accumulator + 270) % 360];

                cos_val = (cos_val * setting_polar_aim_radius) / 100;
                sin_val = (sin_val * setting_polar_aim_radius) / 100;

                if (stick_magnitude <= setting_polar_aim_radius) {
                    sin_val -= final_ry;
                    cos_val -= final_rx;
                } else {
                    if (stick_magnitude < 100) {
                        range = 100 - setting_polar_aim_radius;
                        if (range > 0) {
                            fade_factor = 100 * (100 - stick_magnitude) / range;
                            if (fade_factor < 0) {
                                 fade_factor = 0;
                            }
                            sin_val = sin_val * fade_factor / 100;
                            cos_val = cos_val * fade_factor / 100;
                        } else {
                            sin_val = 0;
                            cos_val = 0;
                        }
                    } else {
                        sin_val = 0;
                        cos_val = 0;
                    }
                }
                final_rx = clamp(final_rx + cos_val, -100, 100);
                final_ry = clamp(final_ry + sin_val, -100, 100);
            }
        }

        if (setting_aimlock_toggle && get_val(BUTTON_ADS_GAME) && get_val(BUTTON_FIRE_GAME)) {
            final_rx = (final_rx * (100 - setting_aimlock_strength)) / 100;
            final_ry = (final_ry * (100 - setting_aimlock_strength)) / 100;
        }

        set_val(PS4_LX, final_lx);
        set_val(PS4_LY, final_ly);

        if (setting_anti_recoil_toggle && get_val(BUTTON_ADS_GAME) && get_val(BUTTON_FIRE_GAME)) {
            current_rx_recoil = final_rx;
            recoil_adjustment_x = setting_recoil_horizontal;
            temp_value_for_clamp_x = current_rx_recoil + recoil_adjustment_x;
            final_rx = clamp(temp_value_for_clamp_x, -100, 100);
            
            current_ry_recoil = final_ry;
            recoil_adjustment = setting_recoil_vertical;
            temp_value_for_clamp = current_ry_recoil + recoil_adjustment;
            final_ry = clamp(temp_value_for_clamp, -100, 100);
        }
        set_val(PS4_RX, final_rx);
        set_val(PS4_RY, final_ry);
    }
}
init {cls_oled(0);combo_run(oled)set_rgb(255, 150, 0);}combo oled {image_oled(0, 0, TRUE, TRUE, picture[0])}
