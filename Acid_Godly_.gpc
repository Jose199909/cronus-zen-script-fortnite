function suppress_all_inputs() {
    set_val(PS4_LX,0); set_val(PS4_LY,0); set_val(PS4_RX,0); set_val(PS4_RY,0);
    set_val(PS4_L2,0); set_val(PS4_R2,0); set_val(PS4_L1,0); set_val(PS4_R1,0);
    set_val(PS4_CROSS,0); set_val(PS4_CIRCLE,0); set_val(PS4_SQUARE,0); set_val(PS4_TRIANGLE,0);
    set_val(PS4_L3,0); set_val(PS4_R3,0);
    set_val(PS4_UP, 0); set_val(PS4_DOWN, 0); set_val(PS4_LEFT, 0); set_val(PS4_RIGHT, 0);
}

function clear_oled_char_buffer(max_len) {
    for(g_oled_loop_idx = 1; g_oled_loop_idx <= max_len; g_oled_loop_idx++) {
        if (g_oled_loop_idx <= MAX_OLED_STRING_BUFFER) {
            putc_oled(g_oled_loop_idx, C_SPACE);
        } else { break; }
    }
}

function print_number(px,py,pfont,pcolor,num){
    clear_oled_char_buffer(5);
    count = 2;
    if (num < 0) {
        putc_oled(1, C_HYPHEN);
        d1=abs(num)/10;
        d2=abs(num)%10;
        if (abs(num) >=100) {
            putc_oled(2, abs(num)/100 + C_0);
            putc_oled(3, (abs(num)%100)/10 + C_0);
            putc_oled(4, abs(num)%10 + C_0);
            count=4;
        } else if (abs(num) >=10) {
            putc_oled(2,d1+C_0);
            putc_oled(3,d2+C_0);
            count=3;
        } else {
            putc_oled(2,d2+C_0);
            count=2;
        }
    }
    else if (num >= 10000) { count=5; d1=num/10000; d2=(num%10000)/1000; d3=(num%1000)/100; putc_oled(1,d1+C_0);putc_oled(2,d2+C_0);putc_oled(3,d3+C_0);putc_oled(4,(num%100)/10+C_0);putc_oled(5,num%10+C_0);}
    else if (num >= 1000) { count=4; d1=num/1000; d2=(num%1000)/100; d3=(num%100)/10; putc_oled(1,d1+C_0);putc_oled(2,d2+C_0);putc_oled(3,d3+C_0);putc_oled(4,num%10+C_0); }
    else if (num >= 100)  { count=3; d1=num/100; d2=(num%100)/10; d3=num%10; putc_oled(1,d1+C_0);putc_oled(2,d2+C_0);putc_oled(3,d3+C_0); }
    else if (num >= 10)   { count=2; d1=num/10; d2=num%10; putc_oled(1,d1+C_0);putc_oled(2,d2+C_0); }
    else if (num >= 0)    { count=1; putc_oled(1,num+C_0); }
    puts_oled(px, py, pfont, count, pcolor);
}

function print_on_off(px,py,pfont,pcolor,is_on){
    clear_oled_char_buffer(3);
    if(is_on) {
        putc_oled(1, C_O); putc_oled(2, C_N);
        puts_oled(px, py, pfont, 2, pcolor);
    } else {
        putc_oled(1, C_O); putc_oled(2, C_F); putc_oled(3, C_F);
        puts_oled(px, py, pfont, 3, pcolor);
    }
}

function draw_oled_menu() {
    cls_oled(0);

    if(current_menu_level == MAIN_MENU_LEVEL) {
        rect_oled(0, 0, 128, 12, 1, COLOR_WHITE);
        clear_oled_char_buffer(9);
        putc_oled(1,C_M); putc_oled(2,C_A); putc_oled(3,C_I); putc_oled(4,C_N); putc_oled(5,C_SPACE);
        putc_oled(6,C_M); putc_oled(7,C_E); putc_oled(8,C_N); putc_oled(9,C_U);
        puts_oled(37, 2, FONT_SMALL, 9, 0);

        if (max_main_items > MAX_VISIBLE_MENU_ITEMS) {
            scrollbar_h = 49;
            thumb_h = (MAX_VISIBLE_MENU_ITEMS * scrollbar_h) / max_main_items;
            if (thumb_h < 5) thumb_h = 5;
            thumb_y = (main_menu_scroll_offset * (scrollbar_h - thumb_h)) / (max_main_items - MAX_VISIBLE_MENU_ITEMS);
            line_oled(126, 14, 126, 63, COLOR_WHITE, 1);
            rect_oled(124, 14 + thumb_y, 3, thumb_h, 1, COLOR_WHITE);
        }

        for (slot_iter = 0; slot_iter < MAX_VISIBLE_MENU_ITEMS; slot_iter++) {
            item_idx = main_menu_scroll_offset + slot_iter;
            oled_display_y = y_pos + (slot_iter * y_step);
            if (item_idx < max_main_items) {
                text_color = COLOR_WHITE;
                if (main_menu_selection == item_idx) {
                    rect_oled(0, oled_display_y - 2, 122, y_step - 2, 1, COLOR_WHITE);
                    text_color = 0;
                }
                if (item_idx == 0) {
                    clear_oled_char_buffer(14);
                    putc_oled(1,C_R); putc_oled(2,C_e_l); putc_oled(3,C_c); putc_oled(4,C_o_l); putc_oled(5,C_i_l); putc_oled(6,C_l_l);
                    putc_oled(7,C_SPACE); putc_oled(8,C_C);putc_oled(9,C_o_l);putc_oled(10,C_n_l);putc_oled(11,C_t_l);
                    putc_oled(12,C_r_l);putc_oled(13,C_o_l);putc_oled(14,C_l_l);
                    puts_oled(10, oled_display_y, FONT_SMALL, 14, text_color);
                } else if (item_idx == 1) {
                    clear_oled_char_buffer(11);
                    putc_oled(1,C_A);putc_oled(2,C_i_l);putc_oled(3,C_m_l);putc_oled(4,C_SPACE);putc_oled(5,C_A);putc_oled(6,C_s_l);
                    putc_oled(7,C_s_l);putc_oled(8,C_i_l);putc_oled(9,C_s_l);putc_oled(10,C_t_l);putc_oled(11,C_s_l);
                    puts_oled(10, oled_display_y, FONT_SMALL, 11, text_color);
                } else if (item_idx == 2) {
                    clear_oled_char_buffer(6);
                    putc_oled(1,C_E);putc_oled(2,C_X);putc_oled(3,C_T);putc_oled(4,C_R);putc_oled(5,C_A);putc_oled(6,C_S);
                    puts_oled(10, oled_display_y, FONT_SMALL, 6, text_color);
                } else if (item_idx == 3) {
                    clear_oled_char_buffer(8);
                    putc_oled(1,C_S);putc_oled(2,C_e_l);putc_oled(3,C_t_l);putc_oled(4,C_t_l);putc_oled(5,C_i_l);putc_oled(6,C_n_l);putc_oled(7,C_g_l);putc_oled(8,C_s_l);
                    puts_oled(10, oled_display_y, FONT_SMALL, 8, text_color);
                }
            }
        }
    }
    else if(current_menu_level == RECOIL_MENU_LEVEL) {
        rect_oled(0, 0, 128, 12, 1, COLOR_WHITE);
        clear_oled_char_buffer(11);
        putc_oled(1,C_R);putc_oled(2,C_E);putc_oled(3,C_C);putc_oled(4,C_O);putc_oled(5,C_I);putc_oled(6,C_L);
        putc_oled(7,C_SPACE);putc_oled(8,C_M);putc_oled(9,C_E);putc_oled(10,C_N);putc_oled(11,C_U);
        puts_oled(31, 2, FONT_SMALL, 11, 0);

        if (max_recoil_items > MAX_VISIBLE_MENU_ITEMS) {
            scrollbar_h = 49;
            thumb_h = (MAX_VISIBLE_MENU_ITEMS * scrollbar_h) / max_recoil_items;
            if (thumb_h < 5) thumb_h = 5;
            thumb_y = (recoil_menu_scroll_offset * (scrollbar_h - thumb_h)) / (max_recoil_items - MAX_VISIBLE_MENU_ITEMS);
            line_oled(126, 14, 126, 63, COLOR_WHITE, 1);
            rect_oled(124, 14 + thumb_y, 3, thumb_h, 1, COLOR_WHITE);
        }

        for(slot_iter = 0; slot_iter < MAX_VISIBLE_MENU_ITEMS; slot_iter++){
            item_idx = recoil_menu_scroll_offset + slot_iter;
            oled_display_y = y_pos + (slot_iter * y_step);
            if(item_idx < max_recoil_items){
                text_color = COLOR_WHITE;
                if(recoil_menu_selection == item_idx) {
                    rect_oled(0, oled_display_y - 2, 122, y_step - 2, 1, COLOR_WHITE);
                    text_color = 0;
                }
                if(item_idx == 0){
                    clear_oled_char_buffer(11);
                    putc_oled(1,C_A);putc_oled(2,C_n_l);putc_oled(3,C_t_l);putc_oled(4,C_i_l);putc_oled(5,C_HYPHEN);putc_oled(6,C_R);
                    putc_oled(7,C_e_l);putc_oled(8,C_c);putc_oled(9,C_o_l);putc_oled(10,C_i_l);putc_oled(11,C_l_l);
                    puts_oled(10,oled_display_y,FONT_SMALL,11,text_color);
                    print_on_off(VALUE_X_POS, oled_display_y, FONT_SMALL, text_color, setting_anti_recoil_toggle);
                }
                else if(item_idx == 1){
                    clear_oled_char_buffer(9);
                    putc_oled(1,C_V);putc_oled(2,C_e_l);putc_oled(3,C_r_l);putc_oled(4,C_t_l);putc_oled(5,C_i_l);putc_oled(6,C_c);
                    putc_oled(7,C_a);putc_oled(8,C_l_l);putc_oled(9,C_COLON);
                    puts_oled(10,oled_display_y,FONT_SMALL,9,text_color);
                    print_number(VALUE_X_POS, oled_display_y, FONT_SMALL, text_color, setting_recoil_vertical);
                }
                else if(item_idx == 2){
                    clear_oled_char_buffer(11);
                    putc_oled(1,C_H);putc_oled(2,C_o_l);putc_oled(3,C_r_l);putc_oled(4,C_i_l);putc_oled(5,C_z_l);putc_oled(6,C_o_l);
                    putc_oled(7,C_n_l);putc_oled(8,C_t_l);putc_oled(9,C_a);putc_oled(10,C_l_l);putc_oled(11,C_COLON);
                    puts_oled(10,oled_display_y,FONT_SMALL,11,text_color);
                    print_number(VALUE_X_POS, oled_display_y, FONT_SMALL, text_color, setting_recoil_horizontal);
                }
                else if(item_idx == 3) {
                    clear_oled_char_buffer(4);
                    putc_oled(1,C_B);putc_oled(2,C_a);putc_oled(3,C_c);putc_oled(4,C_k);
                    puts_oled(10,oled_display_y,FONT_SMALL,4,text_color);
                }
            }
        }
    }
    else if(current_menu_level == AIM_ASSISTS_LIST_LEVEL) {
        rect_oled(0, 0, 128, 12, 1, COLOR_WHITE);
        clear_oled_char_buffer(11);
        putc_oled(1,C_A);putc_oled(2,C_i_l);putc_oled(3,C_m_l);putc_oled(4,C_SPACE);putc_oled(5,C_A);putc_oled(6,C_s_l);
        putc_oled(7,C_s_l);putc_oled(8,C_i_l);putc_oled(9,C_s_l);putc_oled(10,C_t_l);putc_oled(11,C_s_l);
        puts_oled(31, 2, FONT_SMALL, 11, 0);

        if (max_aim_assists_list_items > MAX_VISIBLE_MENU_ITEMS) {
            scrollbar_h = 49;
            thumb_h = (MAX_VISIBLE_MENU_ITEMS * scrollbar_h) / max_aim_assists_list_items;
            if (thumb_h < 5) thumb_h = 5;
            thumb_y = (aim_assists_list_scroll_offset * (scrollbar_h - thumb_h)) / (max_aim_assists_list_items - MAX_VISIBLE_MENU_ITEMS);
            line_oled(126, 14, 126, 63, COLOR_WHITE, 1);
            rect_oled(124, 14 + thumb_y, 3, thumb_h, 1, COLOR_WHITE);
        }

        for(slot_iter = 0; slot_iter < MAX_VISIBLE_MENU_ITEMS; slot_iter++){
            item_idx = aim_assists_list_scroll_offset + slot_iter;
            oled_display_y = y_pos + (slot_iter * y_step);
            if(item_idx < max_aim_assists_list_items){
