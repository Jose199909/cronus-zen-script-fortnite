            else if (strafe_activation_menu_selection == 0) strafe_activation_scroll_offset = 0;
        }
        if(event_press(BUTTON_ENTER)) {
            if (strafe_activation_menu_selection == 0) {
                setting_strafe_activation_idle = !setting_strafe_activation_idle;
                if (setting_strafe_activation_idle) setting_strafe_activation_always = FALSE;
            }
            else if (strafe_activation_menu_selection == 1) {
                setting_strafe_activation_ads = !setting_strafe_activation_ads;
                if (setting_strafe_activation_ads) setting_strafe_activation_always = FALSE;
            }
            else if (strafe_activation_menu_selection == 2) {
                setting_strafe_activation_ads_fire = !setting_strafe_activation_ads_fire;
                if (setting_strafe_activation_ads_fire) setting_strafe_activation_always = FALSE;
            }
            else if (strafe_activation_menu_selection == 3) {
                setting_strafe_activation_always = !setting_strafe_activation_always;
                if (setting_strafe_activation_always) {
                    setting_strafe_activation_idle = FALSE;
                    setting_strafe_activation_ads = FALSE;
                    setting_strafe_activation_ads_fire = FALSE;
                }
            }
            else if (strafe_activation_menu_selection == 4) {
                current_menu_level = STRAFE_CONFIG_LEVEL;
            }
        }
    }
    else if(current_menu_level == JITTER_ACTIVATION_MENU_LEVEL) {
        if(event_press(BUTTON_UP)) {
            jitter_activation_menu_selection --;
            if (jitter_activation_menu_selection < 0) jitter_activation_menu_selection = max_jitter_activation_items - 1;
            if(jitter_activation_menu_selection < jitter_activation_scroll_offset) jitter_activation_scroll_offset = jitter_activation_menu_selection;
            else if (jitter_activation_menu_selection == (max_jitter_activation_items - 1) && max_jitter_activation_items > MAX_VISIBLE_MENU_ITEMS) jitter_activation_scroll_offset = max_jitter_activation_items - MAX_VISIBLE_MENU_ITEMS;
        }
        if(event_press(BUTTON_DOWN)) {
            jitter_activation_menu_selection ++;
            if (jitter_activation_menu_selection >= max_jitter_activation_items) jitter_activation_menu_selection = 0;
            if(jitter_activation_menu_selection >= (jitter_activation_scroll_offset + MAX_VISIBLE_MENU_ITEMS)) jitter_activation_scroll_offset = jitter_activation_menu_selection - MAX_VISIBLE_MENU_ITEMS + 1;
            else if (jitter_activation_menu_selection == 0) jitter_activation_scroll_offset = 0;
        }
        if(event_press(BUTTON_ENTER)) {
            if (jitter_activation_menu_selection == 0) {
