            if(aimlock_config_selection >= (aimlock_config_scroll_offset + MAX_VISIBLE_MENU_ITEMS)) aimlock_config_scroll_offset = aimlock_config_selection - MAX_VISIBLE_MENU_ITEMS + 1;
            else if (aimlock_config_selection == 0) aimlock_config_scroll_offset = 0;
        }
        if(event_press(BUTTON_ENTER)) {
            if(aimlock_config_selection == (max_aimlock_config_items - 1)){
                current_menu_level = AIM_ASSISTS_LIST_LEVEL; aim_assists_list_selection = 0;
                if (aim_assists_list_selection < aim_assists_list_scroll_offset) aim_assists_list_scroll_offset = aim_assists_list_selection;
                else if (aim_assists_list_selection >= (aim_assists_list_scroll_offset + MAX_VISIBLE_MENU_ITEMS)) aim_assists_list_scroll_offset = aim_assists_list_selection - MAX_VISIBLE_MENU_ITEMS + 1;
            }
        }
        if(aimlock_config_selection == 0){
            if(event_press(BUTTON_LEFT)){setting_aimlock_strength -= 5;if(setting_aimlock_strength < 0)setting_aimlock_strength = 0;}
            if(event_press(BUTTON_RIGHT)){setting_aimlock_strength += 5;if(setting_aimlock_strength > 100)setting_aimlock_strength = 100;}
        }
    }
    else if(current_menu_level == STRAFE_CONFIG_LEVEL) {
        if(event_press(BUTTON_UP)) {
            strafe_config_selection --;
            if(strafe_config_selection < 0) strafe_config_selection = max_strafe_config_items - 1;
            if(strafe_config_selection < strafe_config_scroll_offset) strafe_config_scroll_offset = strafe_config_selection;
            else if (strafe_config_selection == (max_strafe_config_items - 1) && max_strafe_config_items > MAX_VISIBLE_MENU_ITEMS) strafe_config_scroll_offset = max_strafe_config_items - MAX_VISIBLE_MENU_ITEMS;
        }
        if(event_press(BUTTON_DOWN)) {
            strafe_config_selection ++;
            if(strafe_config_selection >= max_strafe_config_items) strafe_config_selection = 0;
            if(strafe_config_selection >= (strafe_config_scroll_offset + MAX_VISIBLE_MENU_ITEMS)) strafe_config_scroll_offset = strafe_config_selection - MAX_VISIBLE_MENU_ITEMS + 1;
            else if (strafe_config_selection == 0) strafe_config_scroll_offset = 0;
        }
        if(event_press(BUTTON_ENTER)) {
            if(strafe_config_selection == 0) setting_strafe_toggle = !setting_strafe_toggle;
