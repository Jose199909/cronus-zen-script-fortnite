            if (current_menu_level == MAIN_MENU_LEVEL) {
                if (main_menu_selection < main_menu_scroll_offset) main_menu_scroll_offset = main_menu_selection;
                else if (main_menu_selection >= (main_menu_scroll_offset + MAX_VISIBLE_MENU_ITEMS)) main_menu_scroll_offset = main_menu_selection - MAX_VISIBLE_MENU_ITEMS + 1;
                if (main_menu_selection == 0) main_menu_scroll_offset = 0;
                else if (main_menu_selection == (max_main_items - 1) && max_main_items > MAX_VISIBLE_MENU_ITEMS) main_menu_scroll_offset = max_main_items - MAX_VISIBLE_MENU_ITEMS;
            } else if (current_menu_level == AIM_ASSISTS_LIST_LEVEL) {
