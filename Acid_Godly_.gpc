                if (aim_assists_list_selection == 0) aim_assists_list_scroll_offset = 0;
                else if (aim_assists_list_selection == (max_aim_assists_list_items - 1) && max_aim_assists_list_items > MAX_VISIBLE_MENU_ITEMS) aim_assists_list_scroll_offset = max_aim_assists_list_items - MAX_VISIBLE_MENU_ITEMS;
            } else if (current_menu_level == EXTRAS_MENU_LEVEL) {
                if (extras_menu_selection < extras_menu_scroll_offset) extras_menu_scroll_offset = extras_menu_selection;
                else if (extras_menu_selection >= (extras_menu_scroll_offset + MAX_VISIBLE_MENU_ITEMS)) extras_menu_scroll_offset = extras_menu_selection - MAX_VISIBLE_MENU_ITEMS + 1;
                if (extras_menu_selection == 0) extras_menu_scroll_offset = 0;
