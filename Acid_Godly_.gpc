        } else if (current_menu_level == STICKY_AIM_CONFIG_LEVEL) {
            current_menu_level = AIM_ASSISTS_LIST_LEVEL;
            aim_assists_list_selection = 2;
        } else if (current_menu_level == AIM_DRAG_CONFIG_LEVEL) {
            current_menu_level = AIM_ASSISTS_LIST_LEVEL;
            aim_assists_list_selection = 3;
        } else {
            if (current_menu_level == RECOIL_MENU_LEVEL) { main_menu_selection = 0; }
