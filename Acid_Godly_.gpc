            current_menu_level = EXTRAS_MENU_LEVEL;
            extras_menu_selection = 0;
        } else if (current_menu_level == AIMLOCK_CONFIG_LEVEL) {
            current_menu_level = AIM_ASSISTS_LIST_LEVEL;
            aim_assists_list_selection = 0;
        } else if (current_menu_level == POLAR_AIM_CONFIG_LEVEL) {
