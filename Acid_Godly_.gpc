            else if (current_menu_level == EXTRAS_MENU_LEVEL) { main_menu_selection = 2; }
            else if (current_menu_level == SETTINGS_MENU_LEVEL) { main_menu_selection = 3; }
            current_menu_level = MAIN_MENU_LEVEL;
        }

