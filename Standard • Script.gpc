																																																									/*
Sticky Aim Assist																																																					*/
int StickyAA = FALSE;
																																																									/*
Basic Hip-Abuse																																																						*/
int HipAbuse = FALSE;
																																																									/*
Auto Tracking																																																						*/
int AutoAim = TRUE;
define autoaimtoggle = PS5_SHARE; // Button to toggle AutoTracking

int AimAssist_Strength = 8; // Keep values between 2–15 to reduce leg shake. It won’t remove it fully, but staying in that range helps a lot





















