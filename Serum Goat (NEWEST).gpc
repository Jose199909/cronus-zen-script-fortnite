		if(!V_0271){ 
			V_0272     -= 0x1; // 360 / 100 = 3.6 ( due to no floating points I round up to 4 ) 
			if(V_0272 < 0x0) // When the colourChange has reached max 359 , decrease back to 0 
				V_0271 = TRUE;
		}
		else { 
			V_0272     += 0x1;// 360 / 100 = 3.6 ( due to no floating points I round up to 4 )
			if(V_0272 > 0x167) // when the colourChange has reached 0 , increase back up to 359
				V_0271 = FALSE;
		}
		V_0269 = 0x0; // reset cycleRunTime 
	} 
	set_hsb(V_0272,0x46,0x46);
}

