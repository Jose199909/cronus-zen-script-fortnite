// Variables for function number_to_string()  
int V_0382; 
int V_0383,V_0384; 
function V_047(V_042,V_049) {                  
//=======================================================
//  number_to_string(value to convert, # of digits in value) 
//                                                           
//  Display Up to Max 16-bit Signed Integer (-32,768 to 32,767) 
//                                                      
//      Convert digits to ASCII                         
//      Add ASCII character to print buffer            
//      Print string centered X & Y on OLED             
//                                                       
//======================================================
    V_0382 = 0x1;  V_0384 = 0x2710;

    if(V_042 < 0x0) //--neg numbers                     
    {                                                 
         putc_oled(V_0382,0x2D);    //--add leading "-"      
         V_0382 += 0x1;                                      
         V_042 = abs(V_042);                          
    }

    for(V_0383 = 0x5; V_0383 >= 0x1; V_0383--)                           
    {                                                 
        if(V_049 >= V_0383)                             
        {                                             
            putc_oled(V_0382,V_0386[V_042 / V_0384]);    
            V_042 = V_042 % V_0384;                    
            V_0382 +=  0x1;                                  
            if(V_0383 == 0x4)                               
            {                                         
                putc_oled(V_0382,0x2C);   //--add ","        
                V_0382 += 0x1;                               
            }                                        
        }                                             
        V_0384 /= 0xA;                                  
    }                                                
    puts_oled(V_062(V_0382 - 0x1,OLED_FONT_MEDIUM_WIDTH),0x1B,OLED_FONT_MEDIUM,V_0382 - 0x1,OLED_WHITE); // adjustable value centered in X 
}                                                     
int V_0388;

function V_050(V_042,V_049 ,V_053 , V_054 , V_055) {

    V_0388 = 0x1;  V_0384 = 0x2710;

    if(V_042 < 0x0) //--neg numbers                     
    {                                                 
         putc_oled(V_0388,0x2D);    //--add leading "-" 
         V_0388 += 0x1;                                 
         V_042 = abs(V_042);

    }

    for(V_0383 = 0x5; V_0383 >= 0x1; V_0383--)                           
    {                                                 
        if(V_049 >= V_0383)                             
        {                                              
            putc_oled(V_0388,V_0386[V_042 / V_0384]);
            V_042 = V_042 % V_0384;                    
            V_0388 +=  0x1;

        }                                             
        V_0384 /= 0xA;                                  
    }                                                 
    puts_oled(V_053,V_054,V_055,V_0388 - 0x1,OLED_WHITE); // adjustable value centered in X
}                                       
int V_0398, V_0399;
define V_0400 = 0x24;

function V_056( V_042) {  // antirecoil = edit_val( 0 , antirecoil, 99  , 99  ) 
    line_oled(0x1,0xE,0x7F,0xE,0x1,0x1);                                        
    // print the range values
    line_oled(0x1,0x30,0x7F,0x30,0x1,0x1); 
    // print text 
    print( 0x2, 0x34, OLED_FONT_SMALL, 0x1, V_0401(0x0) ); 
    // print Left/ Right arrow
    rect_oled(0x5A, 0x32, 0x7F, 0x3C, OLED_WHITE , V_0402); // rectangle left (line 1)
    //rect_oled(100, 48, OLED_FONT_SMALL_WIDTH + 2, OLED_FONT_SMALL_HEIGHT + 2, OLED_WHITE, col_rec_right); // rectangle right (line 1)
    putc_oled(0x1,V_0403); 
    puts_oled(0x5B, 0x33, OLED_FONT_SMALL, 0x1, V_0404);     
    putc_oled(0x1,V_0405); 
    puts_oled(0x65, 0x33, OLED_FONT_SMALL, 0x1, V_0406);

    putc_oled(0x1,V_0407); 
    puts_oled(0x6F, 0x33, OLED_FONT_SMALL, 0x1, V_0404);     
    putc_oled(0x1,V_0409); 
    puts_oled(0x79, 0x33, OLED_FONT_SMALL, 0x1, V_0406);

    V_0398 = V_0519[V_0103][0x0];                          
    V_0399 = V_0519[V_0103][0x1];

    // on the left: min value                                          
    V_050(V_0398 ,V_060(V_0398) ,0x4 , 0x14 , OLED_FONT_SMALL); 
    // on the right: max value                                         
    V_050(V_0399 ,V_060(V_0399) ,0x61 , 0x14 , OLED_FONT_SMALL);

    if(get_ival(V_082)){                  
        if(V_058(PS4_RIGHT)){            
            V_042 ++;                           
            if(V_042 > V_0399 ) V_042 = V_0399;   
            V_0260 = TRUE;

        }

        if(V_058(PS4_LEFT)){             
            V_042 --;                           
            if(V_042 < V_0398 ) V_042 = V_0398;   
            V_0260 = TRUE;

        }                                     
        if(V_058(PS4_UP)){               
            V_042 +=0xA;                         
            if(V_042 > V_0399 ) V_042 = V_0399;   
            V_0260 = TRUE;

        }

        if(V_058(PS4_DOWN)){             
            V_042 -=0xA;                         
            if(V_042 < V_0398 ) V_042 = V_0398;   
            V_0260 = TRUE;

        }                                     
    }                                      
    return V_042;                        
}

function V_058(V_059) {       
//  return TRUE - event_press()    
//- every 250ms when button is held 
	  return event_press(V_059) || get_ival(V_059) && get_ptime(V_059) > 0xFA 
	       && get_ptime(V_059) % (get_rtime() * 0x8) == 0x0;
}

function V_060(V_061) {                         
//  find_digits(value)                                
//        return Number of Digits in Value Passed

    V_061 = abs(V_061);                               
    if(V_061 / 0x2710 > 0x0) return 0x5;                   
    if(V_061 /  0x3E8 > 0x0) return 0x4;                   
    if(V_061 /   0x64 > 0x0) return 0x3;                   
    if(V_061 /    0xA > 0x0) return 0x2;                   
                          return 0x1;                  
}                                                     
