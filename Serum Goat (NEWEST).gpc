define V_0255 = 0x0;
function V_018 (V_019){
    if     (V_019 == 0x0) vm_tctrl(inv(0x0));//10 ms Default
    else if(V_019 == 0x1) vm_tctrl(inv(0x2));// 8 ms
    else if(V_019 == 0x2) vm_tctrl(inv(0x4));// 6 ms
    else if(V_019 == 0x3) vm_tctrl(inv(0x6));// 4 ms
    else if(V_019 == 0x4) vm_tctrl(inv(0x8));// 2 ms
    else if(V_019 == 0x5) vm_tctrl(inv(0x9));// 1 ms
}

