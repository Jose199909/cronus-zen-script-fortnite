function V_020(V_021) {

    if (V_021 == 0x0) {
        set_val(V_084, get_val(V_084) + inv(V_0104) + V_0140);

    } else if (V_021 == 0x1) {
        set_val(V_083, get_val(V_083) + inv(V_0104 - V_0104 / V_0141) + V_0139);
        set_val(V_084, get_val(V_084) + inv(V_0104 - V_0104 / V_0141) + V_0140);

    } else if (V_021 == 0x2) {
        set_val(V_083, get_val(V_083) + inv(V_0104) + V_0139);

    } else if (V_021 == 0x3) {
        set_val(V_083, get_val(V_083) + inv(V_0104 - V_0104 / V_0141) + V_0139);
        set_val(V_084, get_val(V_084) + (V_0104 - V_0104 / V_0141) + V_0140);

    } else if (V_021 == 0x4) {
        set_val(V_084, get_val(V_084) + V_0104 + V_0140);

    } else if (V_021 == 0x5) {
        set_val(V_084, get_val(V_084) + V_0104 - V_0104 / V_0141 + V_0140);
        set_val(V_083, get_val(V_083) + V_0104 - V_0104 / V_0141 + V_0139);

    } else if (V_021 == 0x6) {
        set_val(V_083, get_val(V_083) + V_0104 + V_0139);

    } else if (V_021 == 0x7) {
        set_val(V_083, get_val(V_083) + V_0104 - V_0104 / V_0141 + V_0139);
        set_val(V_084, get_val(V_084) + inv(V_0104 - V_0104 / V_0141) + V_0140);
    }
}

function V_022() {
    V_0137 += get_rtime();

    V_020(V_0138);

    if (V_0137 > 0x65 - V_0105) {
        V_0138 = (V_0138 + 0x1) % 0x8;
        V_0137 = 0x0;
    }
}

function V_023(V_024, V_025) {

    if (V_025 == 0x0) {
        set_val(V_024, get_val(V_024) + inv(V_0104) + V_0139);

    } else if (V_025 == 0x1) {
        set_val(V_024, get_val(V_024) + V_0104 + V_0139);
    }
}

function V_026() {

    V_0137 += get_rtime();

    V_0143 = get_ival(V_083);
    V_0144 = get_ival(V_084);

    if (abs(V_0143) > abs(V_0144)) {

        if (abs(V_0143) > V_0107) {
            V_023(V_083, V_0142);
        }
    } else {

        if (abs(V_0144) > V_0107) {
            V_023(V_084, V_0142);
        }
        if (abs(V_0144) == abs(V_0143)) {
            V_023(V_084, V_0142  + V_0140); 
            V_023(V_083, V_0142 + V_0139);
        }
    }

    if (V_0137 > 0x65 - V_0105) {
        V_0142 = (V_0142 + 0x1) % 0x2;
        V_0137 = 0x0;
    }
}

int V_0309 = TRUE;

int V_0310, V_0311, V_0312, V_0313;

function V_027() {
	if(V_0309){
			V_0310 += get_rtime();
			if(V_0310 >= 0x32 + V_0313){
				V_0311++;
				V_0312++;
				V_0313 = V_0313 + 0x2;
				V_0310 = 0x0;
				cls_oled(0x0);
			}
			if(V_0311 == 0x5)V_0311=0x0;
			image_oled(0x0,0x0,0x1,0x1,V_0316[V_0311]);
		}
		if(V_0312 >= 0x32){
			V_0309 = FALSE;
			cls_oled(0x0);
		}
		if(!V_0309){
			V_0312++;
			image_oled(0x5A,0x0,0x1,0x1,V_0316[0x3]);
		}

}

// Prints text to the screen
 function V_0265(V_031, V_032, V_0321, V_033, V_034) {
	V_028(V_0321);
	V_030(V_031, V_032, V_033, V_034);
}
function V_028(V_029) {
	// Loop through each character of the string
    do {
    	V_035(dint8(V_029)); // Insert character into display buffer
    	V_029++; // Move to next character of the string
    } while(dint8(V_029)) // Check if a next character exists
}
int V_0329;
function V_030(V_031, V_032, V_033, V_034) {
	// Decrement display buffer value for proper arithmetic
	V_0329--;

	// Check horizontal alignment
	switch(V_031) { 
		case V_0171 {
			V_031 = OLED_WIDTH - (V_0329 * V_0514[V_033]) - 0x4; // Additional 4 for padding from border
			break;	
		} case V_0170 {
			V_031 = (OLED_WIDTH >> 0x1) - ((V_0329 * V_0514[V_033]) >> 0x1);
			break;
		}
		// No alignLeft case is needed because alignLeft is set to the proper left alignment already
	}

	// Check vertical alignment
	switch(V_032) { 
		case V_0170 {
			V_032 = (OLED_HEIGHT >> 0x1) - (V_0515[V_033] >> 0x1);
			break;
		} case V_0173 {
			V_032 = OLED_HEIGHT - V_0515[V_033] - 0x4; // Additional 4 for padding from border
			break;	
		}
		// No alignTop case is needed because alignTop is set to the proper top alignment already
	}

	puts_oled(V_031, V_032, V_033, V_0329, V_034); // Output display buffer
	V_0329 = 0x1; // Reset display buffer
}
function V_035(V_036) {
	putc_oled(V_0329, V_036);
	V_0329++;
}

