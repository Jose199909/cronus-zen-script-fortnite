Axis = isqrt(abs(get_ival(RX)) * abs(get_ival(RX)) + abs(get_ival(RY)) * abs(get_ival(RY)));                       

  if (RushStickyToggle) {

  if (get_ival(ADS) || (BattsAAHip && get_ival(Fire))) {

  combo_run(StickyAssist);

  } else {

  combo_stop(StickyAssist); 

                }

                

            }

if (iAimToggle) {



        if(get_ival(Fire) && !get_ival(ADS)){

            combo_run(HipfireStickyAim);

    	}

    	if(get_ival(Fire) && get_ival(ADS)){

    		combo_run(AdsStickyAim);

    		

    	}

	

	actual_X = get_val(X);

    actual_Y = get_val(Y);

    actual_Magnitude = isqrt(pow(actual_X, 2) + pow(actual_Y, 2));

    max_Magnitude = (actual_Magnitude < 100);

    

    if (!(time++ % STEP_INTERVAL)) {

      	

      	angle += STEPS;

    }

    

    angle = angle % 360;

    sin_angle = PolarArray[angle % 360];

    cos_angle = PolarArray[(angle + 270) % 360];

    cos_angle = (cos_angle * RADIUS) / 100;

    sin_angle = (sin_angle * RADIUS) / 100;

    

    if((get_ival(XB1_LT)) || (get_ival(XB1_RT))){

      	

      	if(actual_Magnitude <= iAimPower[CurrentProfile]){

        	sin_angle -= actual_Y;

        	cos_angle -= actual_X;

      	

      	}else {

        	

        	sin_angle = (sin_angle * (200 - ((abs(actual_Y) + actual_Magnitude) / 10) * 10) / 200) * max_Magnitude;

        	cos_angle = (cos_angle * (200 - ((abs(actual_X) + actual_Magnitude) / 10) * 10) / 200) * max_Magnitude;

      }

      

      set_val(X,clamp(actual_X + cos_angle, -100, 100));

      set_val(Y,clamp(actual_Y + sin_angle, -100, 100));

    }

	combo_run(AA111)

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile]) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile])) {

	combo_stop(AA111)

	combo_run(AA211)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 1) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 1)){

	combo_stop(AA211)

	combo_run(AA3)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 2) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 2)) {

	combo_stop(AA3)

	combo_run(AA4)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 3) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 3)) {

	combo_stop(AA4)

	combo_run(AA5)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 4) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 4)){

	combo_stop(AA5)

	combo_run(AA6)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 5) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 5)){

	combo_stop(AA6)

	combo_run(AA7)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 6) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 6)){

	combo_stop(AA7)

	combo_run(AA8)

	}

	if(abs(get_val(PS4_RX)) > (iAimPower[CurrentProfile] + 10) || abs(get_val(PS4_RY)) > (iAimPower[CurrentProfile] + 10)){

	combo_stop(AA8)

	}

if(get_val(PS4_L2) > 50){

if(abs(get_val(XB1_RX) < iAimPower[CurrentProfile])) 

if(abs(get_val(XB1_RY) < iAimPower[CurrentProfile])) 

if(abs(get_val(XB1_RX) > -iAimPower[CurrentProfile])) 

if(abs(get_val(XB1_RY) > -iAimPower[CurrentProfile])){

PPFX = PolarFlow(PPFX,PXS,PXSE,PVSI,PFD,1);

PPFY = PolarFlow(PPFY,PYS,PYSE,PVS,PPFD,2);

set_polar(POLAR_RS,30,PPFX);

set_polar(POLAR_RS,30,PPFY);}}



AxisXY = isqrt(abs(get_ival(RX)) * abs(get_ival(RX)) + abs(get_ival(RY)) * abs(get_ival(RY)));

if (AssistProfile == 1)

AimAssist(iAimPower[CurrentProfile],iAimPower[CurrentProfile]);





Aim_Val  = iAimPower[CurrentProfile];

Wait_Val = 1;

combo_run (TheSticky)

}



if (ExtremeAimToggle) {

if (get_val (XB1_RT)) { 

set_val(RX, (get_ival(RX) + random(0x1 * -1, 0x1) * 2));

set_val(RY, (get_ival(RY) + random(0x1 * -1, 0x1) * 2)); 

combo_run (AA1); combo_run (AA2);}

}



if (RapidFireToggle) {

if(get_val(Fire)) {

combo_run (RapidFire);

}

} 



if (NoVibrationToggle) {

block_rumble ();

}



 if(AimBotToggle){

  if (get_val(ADS) && get_val (Fire)){

combo_run(AimBot1)if(abs(get_val(PS4_RX)) > 22 || abs(get_val(PS4_RY)) > 22 || abs(get_val(PS4_LY)) > 16 || abs(get_val(PS4_LX)) > 16)combo_stop(AimBot1)}

combo_run(AimBot2) if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > iAimPower[CurrentProfile] || abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) < -iAimPower[CurrentProfile])combo_stop(AimBot2)

combo_run(AimBot3) if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > iAimPower[CurrentProfile] + 1 || abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) < -iAimPower[CurrentProfile] + 1)combo_stop(AimBot3)

combo_run(AimBot4) if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > iAimPower[CurrentProfile] + 2 || abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) < -iAimPower[CurrentProfile] + 2)combo_stop(AimBot4)

combo_run(AimBot5)if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > iAimPower[CurrentProfile] + 3 || abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) < -iAimPower[CurrentProfile] + 3)combo_stop(AimBot5) 

   }



if(CrouchShotToggle[CurrentProfile]) {

if (get_val (Fire) && get_val (ADS)) {

combo_run (CrouchShot);

}

}



StrafeToggle[CurrentProfile] = ToggleFeature(XB1_LT, PS4_UP, 500, StrafeToggle[CurrentProfile], StrafeMod);

FlyingAimToggle[CurrentProfile] = ToggleFeature(XB1_LT, PS4_RIGHT, 500, FlyingAimToggle[CurrentProfile], FlyingAimMod);

RecoilNegatorToggle[CurrentProfile] = ToggleFeature(XB1_LT, PS4_DOWN, 500, RecoilNegatorToggle[CurrentProfile], RecoilNegatorMod);

                    

if(ShowLogo) {

ClearScreen()

}

if(!ActiveScreenTimer && !ShowLogo && !ShowText && !MenuVisible) {

    image_oled(0, 0, TRUE, TRUE, TwixyAimlogo[0]); }



                

if(RefreshUI) {

ShowLogo = FALSE;



if(OpenEditMenu) {

UpdateMenuTitle();

rect_oled(38, 18, 51, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_BLACK);

rect_oled(27, 31, 74, OLED_FONT_SMALL_HEIGHT + 6, OLED_WHITE, OLED_BLACK);

DisplayModValues();

} else if(OpenMainMenu) {

UpdateMenuTitle();

UpdateFeatureDisplay();

UpdateStatusDisplay();

} else {

cls_oled(OLED_BLACK);

print(HorizontalCenterText(CalculateStringLength(TextList(ModNames, CurrentMod)), OLED_FONT_SMALL_WIDTH),TitleYPosition,OLED_FONT_SMALL,OLED_WHITE,TextList(ModNames, CurrentMod));

UpdateStatusDisplay();



}

ActiveScreenTimer = TRUE;

RefreshUI = FALSE;

}

                

if(RefreshFooter) {

MenuCounter = 0;

rect_oled(1, 50, 126, 13, OLED_WHITE, OLED_BLACK);

if(OpenMainMenu) {

PageIndex = ClampValue(PageIndex, 0, ListLength(PSInstructions));

if(get_controller() == PIO_PS4)

print(HorizontalCenterText(CalculateStringLength(TextList(PSInstructions, PageIndex)), OLED_FONT_SMALL_WIDTH),FooterYPosition,OLED_FONT_SMALL,OLED_WHITE,TextList(PSInstructions, PageIndex));

else

print(HorizontalCenterText(CalculateStringLength(TextList(XboxInstructions, PageIndex)), OLED_FONT_SMALL_WIDTH),FooterYPosition,OLED_FONT_SMALL,OLED_WHITE,TextList(XboxInstructions, PageIndex));

}

if(OpenEditMenu) {

PageIndex = ClampValue(PageIndex, 0, ListLength(PSEditor));

if(get_controller() == PIO_PS4)

print(HorizontalCenterText(CalculateStringLength(TextList(PSEditor, PageIndex)), OLED_FONT_SMALL_WIDTH),FooterYPosition,OLED_FONT_SMALL,OLED_WHITE,TextList(PSEditor, PageIndex));

else

print(HorizontalCenterText(CalculateStringLength(TextList(XboxEditor, PageIndex)), OLED_FONT_SMALL_WIDTH),FooterYPosition,OLED_FONT_SMALL,OLED_WHITE,TextList(XboxEditor, PageIndex));

}

RefreshFooter = FALSE;

}

if(UpdateDisplay) {

ShowLogo= FALSE;

if(!ShowText) {

cls_oled(0);

image_oled(0, 0, TRUE, TRUE, TwixyAimlogo[0]);

} else

rect_oled(0, 45, 128, 31, OLED_WHITE, OLED_BLACK);

DisplayValue(ProfileValue, CountDigits(ProfileValue));

DisplayMenuTitle();

ShowText = TRUE;

ActiveScreenTimer = TRUE;

UpdateDisplay = FALSE;

}

}



combo StickyAssist {

   

set_val(PS4_RY,AxisRelease(PS4_RY,RushStickyPower));

   wait(8);

set_val(PS4_RX,AxisRelease(PS4_RX,RushStickyPower));

set_val(PS4_LX,AxisRelease(PS4_LX,RushStickyPower));

   wait(8);

set_val(PS4_RY,AxisRelease(PS4_RY,inv(RushStickyPower)));

   wait(8);

set_val(PS4_RX,AxisRelease(PS4_RX,inv(RushStickyPower)));

set_val(PS4_LX,AxisRelease(PS4_LX,inv(RushStickyPower)));

   wait(8);

}

combo AA111 {

set_val(PS4_RX,AA111)wait(1)set_val(PS4_RY,AA111) set_val(PS4_RX,-AA111)wait(1)set_val(PS4_RY,-AA111)

}

combo AA211 {

	set_val(PS4_RX,AA211) set_val(PS4_RY,AA211) set_val(PS4_RX,-AA211)wait(1)set_val(PS4_RY,-AA211)

}

combo AA3 {

	set_val(PS4_RX,AA3)wait(1)set_val(PS4_RY,AA3) set_val(PS4_RX,-AA3) set_val(PS4_RY,-AA3)

}

combo AA4 {

	set_val(PS4_RX,AA4)wait(1)set_val(PS4_RY,AA4) set_val(PS4_RX,-AA4)wait(1)set_val(PS4_RY,-AA4)

}

combo AA5 {

	set_val(PS4_RX,AA5)wait(1)set_val(PS4_RY,AA5) wait(1)set_val(PS4_RX,-AA5)wait(1)set_val(PS4_RY,-AA5)

}

combo AA6 {

	set_val(PS4_RX,AA6)wait(1)set_val(PS4_RY,AA6) wait(1)set_val(PS4_RX,-AA6)wait(1)set_val(PS4_RY,-AA6)

}

combo AA7 {

	set_val(PS4_RX,AA7)wait(1)set_val(PS4_RY,AA7) wait(1)set_val(PS4_RX,-AA7)wait(1)set_val(PS4_RY,-AA7)

	}

combo AA8{

    set_val(PS4_RX,AA8)wait(1)set_val(PS4_RY,AA8)wait(1) set_val(PS4_RX,-AA8)wait(1) set_val(PS4_RY,-AA8)

}

combo HipfireStickyAim {

offset2(PS4_RY,HipAimAssistSize);

wait(2);

offset2(PS4_RX,iAimPower[CurrentProfile]);

offset2(PS4_LX,iAimPower[CurrentProfile]);

wait(2);

offset2(PS4_RY,inv(iAimPower[CurrentProfile]));

wait(2);

offset2(PS4_RX,inv(iAimPower[CurrentProfile]));

offset2(PS4_LX,inv(iAimPower[CurrentProfile]));

wait(2);

}

combo AdsStickyAim {

offset2(PS4_RY,iAimPower[CurrentProfile] + 3);

wait(4);

offset2(PS4_RX,iAimPower[CurrentProfile] + 3);

offset2(PS4_LX,iAimPower[CurrentProfile] + 3);

wait(4);

offset2(PS4_RY,inv(iAimPower[CurrentProfile] - 2));

wait(4);

offset2(PS4_RX,inv(iAimPower[CurrentProfile] - 2));

offset2(PS4_LX,inv(iAimPower[CurrentProfile] - 2));

wait(4);

}



combo PickupMacro {

set_val(InteractButton, 100);

wait(10);

set_val(InteractButton, 0);

}

combo AimLock { 

	set_val(PS4_RX,0);

	set_val(PS4_RY,0);

	wait(85);

	offset(POLAR_RX,(cosAngle >> 1));

	offset(POLAR_RY,(sinAngle >> 1));

	wait(200);

}

combo RecoilNegatorPower {

AdjustRecoilNegator = get_ival(PS4_RY) + RecoilNegatorPower;

if(AdjustRecoilNegator > 100 + 100 - 100)

RecoilNegatorPower = 100 - 100 + 100;

set_val(PS4_RY, RecoilNegatorPower)

}

function RecoilNegatorPower() {

if(get_val(XB1_RT) && get_val(XB1_LT))

combo_run(RecoilNegatorPower)

if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > RecoilNegatorPower - 100 + 100)

combo_stop(RecoilNegatorPower)

return;

}

combo RumbleActivate {

set_rgb(0, 175, 240);

set_rumble(RUMBLE_B, 50);

wait(150);

reset_rumble();

wait(100);

set_rumble(RUMBLE_B, 50);

wait(150);

reset_rumble();

}



combo RumbleDeactivate {

set_rgb(255, 0, 0);

set_rumble(RUMBLE_A, 50);

wait(300);

reset_rumble();

wait(400);

}



combo SavedMessage {

call(RumbleActivate);

wait(150);

call(RumbleActivate);

wait(1000);

set_rgb(0, 175, 240);

combo_run(ShowLogo)

}



function Initiate (Input) {

return event_press(Input) || get_val(Input) && get_ptime(Input) > 250 && get_ptime(Input) % (get_rtime() * 8) == 0;

}	



function UpdateMenuTitle() {

rect_oled(13, 1, 102, OLED_FONT_SMALL_HEIGHT + 5, OLED_WHITE, OLED_BLACK);

if(OpenMainMenu) {

if(CurrentMod < ModCount)

DisplayMenuTitle();

else

print(HorizontalCenterText(sizeof(AllProfilesMessage) - 1, OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, AllProfilesMessage[0]);

}

if(OpenEditMenu) {

print(HorizontalCenterText(CalculateStringLength(TextList(PowerValues, CurrentValue)), OLED_FONT_SMALL_WIDTH), TopMargin, OLED_FONT_SMALL, OLED_WHITE, TextList(PowerValues, CurrentValue));

}

}



function UpdateFeatureDisplay() {

rect_oled(13, 17, 102, OLED_FONT_SMALL_HEIGHT + 5, OLED_WHITE, OLED_BLACK);

if(OpenMainMenu) {

print(HorizontalCenterText(CalculateStringLength(TextList(ModNames, CurrentMod)), OLED_FONT_SMALL_WIDTH), TitleYPosition, OLED_FONT_SMALL, OLED_WHITE, TextList(ModNames, CurrentMod));

}

}



function UpdateStatusDisplay() {

rect_oled(13, 33, 102, OLED_FONT_SMALL_HEIGHT + 5, OLED_WHITE, OLED_BLACK);

StatusDisplay(StrafeMod, StrafeToggle[CurrentProfile]);

StatusDisplay(FlyingAimMod, FlyingAimToggle[CurrentProfile]);

StatusDisplay(AimBotMod, AimBotToggle[CurrentProfile]);

StatusDisplay(RushStickyMod, RushStickyToggle[CurrentProfile]);

StatusDisplay(SpeedMod, SpeedToggle[CurrentProfile]);

StatusDisplay(CrouchShotMod, CrouchShotToggle[CurrentProfile]);

StatusDisplay(BloomNegatorMod, BloomNegatorToggle[CurrentProfile]);

StatusDisplay(NoVibrationMod, NoVibrationToggle[CurrentProfile]);

StatusDisplay(PreFireMod, PreFireToggle[CurrentProfile]);

StatusDisplay(RapidFireMod, RapidFireToggle[CurrentProfile]);

StatusDisplay(iAimMod, iAimToggle[CurrentProfile]);

StatusDisplay(ExtremeAimMod, ExtremeAimToggle[CurrentProfile]);

StatusDisplay(RushAimLockMod, RushAimLockToggle[CurrentProfile]);

StatusDisplay(AimAbuseMod, AimAbuseToggle[CurrentProfile]);

StatusDisplay(ApocalypseAimMod, ApocalypseAimToggle[CurrentProfile]);

StatusDisplay(LongRangeMod, LongRangeToggle[CurrentProfile]);

StatusDisplay(RecoilNegatorMod, RecoilNegatorToggle[CurrentProfile]);

}



function DisplayModValues() {

if(CurrentValue == StrafeValue)

DisplayValue(StrafePower[CurrentProfile], CountDigits(StrafePower[CurrentProfile]));

else if(CurrentValue == RushStickyValue)

DisplayValue(RushStickyPower[CurrentProfile], CountDigits(RushStickyPower[CurrentProfile]));

else if(CurrentValue == iAimValue)

DisplayValue(iAimPower[CurrentProfile], CountDigits(iAimPower[CurrentProfile]));

else if(CurrentValue == ApocalypseAimValue)

DisplayValue(ApocalypseAimPower[CurrentProfile], CountDigits(ApocalypseAimPower[CurrentProfile]));

else if(CurrentValue == LongRangeValue)

DisplayValue(LongRangePower[CurrentProfile], CountDigits(LongRangePower[CurrentProfile]));

else if(CurrentValue == RecoilNegatorValue)

DisplayValue(RecoilNegatorPower[CurrentProfile], CountDigits(RecoilNegatorPower[CurrentProfile]));

else if(CurrentValue == AimBotValue)

DisplayValue(AimBotPower[CurrentProfile], CountDigits(AimBotPower[CurrentProfile]));

}



function DisplayMenuTitle() {

if(UpdateDisplay)

TextPosition = 50;

else

TextPosition = 4;

print(29, TextPosition, OLED_FONT_SMALL, OLED_WHITE, TwixyScripts[0]);

}



function StatusDisplay (ListIndex, ListEnabled) {

if(CurrentMod == ListIndex) {

if(ListEnabled == 1)

print(HorizontalCenterText(sizeof(OnMessage) - 1, OLED_FONT_SMALL_WIDTH), StatusYPosition, OLED_FONT_SMALL, OLED_WHITE, OnMessage[0]);

else

print(HorizontalCenterText(sizeof(OffMessage) - 1, OLED_FONT_SMALL_WIDTH), StatusYPosition, OLED_FONT_SMALL, OLED_WHITE, OffMessage[0]);}

}



function AdjustingValue (ListIndex, Values, MinimumAdjustedValue, MaximumAdjustedValue, SmallIncrement, LargeIncrement) {

if(CurrentValue == ListIndex) {

Values = AdjustThroughButton(Values, XB1_LEFT, inv(SmallIncrement), MinimumAdjustedValue, MaximumAdjustedValue);

Values = AdjustThroughButton(Values, PS4_RIGHT, SmallIncrement, MinimumAdjustedValue, MaximumAdjustedValue);

Values = AdjustThroughButton(Values, PS4_DOWN, inv(LargeIncrement), MinimumAdjustedValue, MaximumAdjustedValue);

Values = AdjustThroughButton(Values, PS4_UP, LargeIncrement, MinimumAdjustedValue, MaximumAdjustedValue);}

return Values;

}



function AdjustThroughButton (Values, ButtonInput, ButtonIncrement, MinimumButtonValue, MaximumButtonValue) {

if(ButtonPressed(ButtonInput)) {

Values += ButtonIncrement;

if(Values < MinimumButtonValue)

Values = MinimumButtonValue;

if(Values > MaximumButtonValue)

Values = MaximumButtonValue;

RefreshUI = TRUE;}

return Values;

}



function Toggle (ListIndex, Values) {

if(event_press(PS4_UP)) {

if(CurrentMod == ListIndex) {

Values = ClampValue(Values + 1, 0, 1);

if(Values == 0)

combo_run(RumbleDeactivate);

else

combo_run(RumbleActivate);

}

RefreshUI = TRUE;

}

if(event_press(PS4_DOWN)) {

if(CurrentMod == ListIndex) {

Values = ClampValue(Values - 1, 0, 1);

if(Values == 0)

combo_run(RumbleDeactivate);

else

combo_run(RumbleActivate);

}

RefreshUI = TRUE;

}

return Values;

}



function ToggleFeature (TriggerButton, ActionButton, HoldTime, Values, ListIndex) {

if(get_val(TriggerButton)) {

if(get_val(ActionButton) && get_ptime(ActionButton) == HoldTime) {

CurrentMod = ListIndex;

Values = !Values;

if(Values == 0)

combo_run(RumbleDeactivate);

else

combo_run(RumbleActivate);

RefreshUI = TRUE;

}



}

return Values;

}



function ActiveChangeableValues() {

if(CurrentMod == StrafeMod && StrafeToggle[CurrentProfile])

return TRUE;

if(CurrentMod == RushStickyMod && RushStickyToggle[CurrentProfile])

return TRUE;

if(CurrentMod == iAimMod && iAimToggle[CurrentProfile])

return TRUE;

if(CurrentMod == ApocalypseAimMod && ApocalypseAimToggle[CurrentProfile])

return TRUE;

if(CurrentMod == LongRangeMod && LongRangeToggle[CurrentProfile])

return TRUE;

if(CurrentMod == RecoilNegatorMod && RecoilNegatorToggle[CurrentProfile])

return TRUE;

if(CurrentMod == AimBotMod && AimBotToggle[CurrentProfile])

return TRUE;

return FALSE;

}



function ListLength (ListType) {

ArrayIndex = 0;

if(ListType == ModNames) {

while(FeaturesList[ArrayIndex] != -1) {

ArrayIndex++;

}

} else if(ListType == PowerValues) {

while(ValuesList[ArrayIndex] != -1) {

ArrayIndex++;

}

} else if(ListType == PSInstructions) {

while(PSMenuInstructions[ArrayIndex] != -1) {

ArrayIndex++;

}

} else if(ListType == PSEditor) {

while(PSEditInstructions[ArrayIndex] != -1) {

ArrayIndex++;

}

} else if(ListType == XboxInstructions) {

while(XboxMenuInstructions[ArrayIndex] != -1) {

ArrayIndex++;

}

} else if(ListType == XboxEditor) {

while(XboxEditInstructions[ArrayIndex] != -1) {

ArrayIndex++;

}

}

return ArrayIndex - 1;

}



function TextList (ListType, ListIndex) {

if(ListType == ModNames)

return FeaturesList[ListIndex];

if(ListType == PowerValues)

return ValuesList[ListIndex];

if(ListType == PSInstructions)

return PSMenuInstructions[ListIndex];

if(ListType == PSEditor)

return PSEditInstructions[ListIndex];

if(ListType == XboxInstructions)

return XboxMenuInstructions[ListIndex];

if(ListType == XboxEditor)

return XboxEditInstructions[ListIndex];

return -1;

}



function CalculateStringLength (StringPointer) {

StringLength = 0;

while(duint8(StringPointer++)) {

StringLength++;

}

return StringLength + 1;

}



function DisplayValue (Values, ValuesCount) {

ArrayIndex = 1;

Divisor = 10000;

if(Values < 0) {

putc_oled(ArrayIndex, 45);

ArrayIndex += 1;

Values = abs(Values);

}

for(DigitCounter = 5; DigitCounter >= 1; DigitCounter--) {

if(ValuesCount >= DigitCounter) {

putc_oled(ArrayIndex, DigitalCharacters[Values / Divisor]);

Values = Values % Divisor;

ArrayIndex += 1;

}

Divisor /= 10;

}

if(UpdateDisplay)

puts_oled(120, 54, OLED_FONT_SMALL, ArrayIndex - 1, OLED_WHITE);

else

puts_oled(HorizontalCenterText(ArrayIndex - 1, OLED_FONT_MEDIUM_WIDTH), 28, OLED_FONT_MEDIUM, ArrayIndex - 1, OLED_WHITE);

}



function ContainerMenuLayout() {

rect_oled(0, 0, 128, 49, OLED_BLACK, OLED_WHITE);

line_oled(1, 16, 126, 16, 1, OLED_WHITE);

rect_oled(2, 2, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);

rect_oled(115, 2, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);

}



function MainMenuLayout() {

rect_oled(1, 17, 126, 31, OLED_WHITE, OLED_BLACK);

line_oled(1, 32, 126, 32, 1, OLED_WHITE);

rect_oled(2, 18, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);

rect_oled(115, 18, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);

rect_oled(2, 34, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);

rect_oled(115, 34, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 3, OLED_WHITE, OLED_WHITE);

}



function EditMenuLayout() {

rect_oled(1, 17, 126, 31, OLED_WHITE, OLED_BLACK);

rect_oled(2, 18, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 4, OLED_WHITE, OLED_WHITE);

rect_oled(115, 18, OLED_FONT_SMALL_WIDTH + 4, OLED_FONT_SMALL_HEIGHT + 4, OLED_WHITE, OLED_WHITE);

