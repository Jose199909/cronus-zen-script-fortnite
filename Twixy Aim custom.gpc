PageIndex = 0;

OpenMainMenu = TRUE;

OpenEditMenu = FALSE;

MainMenuLayout();

ControllerIcons();

HorizontalNavigation();

VerticalNavigation();

RefreshUI = TRUE;

RefreshFooter = TRUE;

}

if(event_press(PS4_RIGHT)) {

CurrentValue += 1;

RefreshUI = TRUE;

}

if(event_press(XB1_LEFT)) {

CurrentValue -= 1;

RefreshUI = TRUE;

}

if(CurrentMod == StrafeMod)

CurrentValue = ClampValue(CurrentValue, StrafeValue, StrafeValue);

if(CurrentMod == RushStickyMod)

CurrentValue = ClampValue(CurrentValue, RushStickyValue, RushStickyValue);

if(CurrentMod == iAimMod)

CurrentValue = ClampValue(CurrentValue, iAimValue, iAimValue);

if(CurrentMod == ApocalypseAimMod)

CurrentValue = ClampValue(CurrentValue, ApocalypseAimValue, ApocalypseAimValue);

if(CurrentMod == RecoilNegatorMod)

CurrentValue = ClampValue(CurrentValue, RecoilNegatorValue, RecoilNegatorValue);

if(CurrentMod == AimBotMod)

CurrentValue = ClampValue(CurrentValue, AimBotValue, AimBotValue);

}

}

                

if(OpenMainMenu || OpenEditMenu) {

