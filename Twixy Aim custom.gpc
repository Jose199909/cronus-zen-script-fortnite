StrafePower[CurrentProfile] = AdjustingValue(StrafeValue, StrafePower[CurrentProfile], 0, 100, 1, 10);

RecoilNegatorPower[CurrentProfile] = AdjustingValue(RecoilNegatorValue, RecoilNegatorPower[CurrentProfile], 0, 100, 1, 10);

RushStickyPower[CurrentProfile] = AdjustingValue(RushStickyValue, RushStickyPower[CurrentProfile], -100, 100, 1, 10);

iAimPower[CurrentProfile] = AdjustingValue(iAimValue, iAimPower[CurrentProfile], -100, 100, 1, 10);

ApocalypseAimPower[CurrentProfile] = AdjustingValue(ApocalypseAimValue, ApocalypseAimPower[CurrentProfile], 0, 100, 1, 10);

LongRangePower[CurrentProfile] = AdjustingValue(LongRangeValue, LongRangePower[CurrentProfile], 0, 100, 1, 10);

AimBotPower[CurrentProfile] = AdjustingValue(AimBotValue, AimBotPower[CurrentProfile], 0, 40, 1, 10);

} else {

