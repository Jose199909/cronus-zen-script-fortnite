MenuCounter += get_rtime();

if(MenuCounter > 2000) {

PageIndex++;

RefreshFooter = TRUE;

}

if(!get_ival(XB1_LT) && event_release(PS4_PS))

Menu();

ResetInputs();

}

                

if(!OpenMainMenu && !OpenEditMenu) {









