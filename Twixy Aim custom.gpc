set_val(PS4_SHARE, 0);

}

}

}

}





            

if(!MenuVisible) {



if(!BlockMenu) {

if(get_ival(XB1_LT)) {

if(event_release(PS4_OPTIONS)) {

cls_oled(OLED_BLACK);

ShowText = FALSE;



if(OpenEditMenu) {

OpenEditMenu = FALSE;

image_oled(0, 0, TRUE, TRUE, TwixyAimlogo[0]);

} else OpenMainMenu = !OpenMainMenu;



if(!OpenMainMenu) {

combo_run(RumbleDeactivate);

image_oled(0, 0, TRUE, TRUE, TwixyAimlogo[0]);

}



if(!get_ival(XB1_LT) && event_release(PS4_PS)) {

Menu();

}



if(OpenMainMenu) {

CurrentMod = StrafeMod;

PageIndex = 0;

combo_run(RumbleActivate);

ContainerMenuLayout();

MainMenuLayout();

ControllerIcons();

HorizontalNavigation();

VerticalNavigation();

RefreshUI = TRUE;

RefreshFooter = TRUE;

}



}

set_val(PS4_OPTIONS, 0);

}

}

                

if(OpenMainMenu) {

 

MenuIconHighlights();

if(ActiveChangeableValues()) {

if(event_release(PS4_CROSS)) {

PageIndex = 0;

OpenEditMenu = TRUE;

OpenMainMenu = FALSE;

EditMenuLayout();

ControllerIcons();

HorizontalNavigation();

EditMenu();

VerticalNavigation();

RefreshUI = TRUE;

RefreshFooter = TRUE;

}

}

                    

if(event_press(PS4_RIGHT)) {

CurrentMod = ClampValue(CurrentMod + 1, 0, ListLength(ModNames));

RefreshUI = TRUE;

}

                    

if(event_press(XB1_LEFT)) {

CurrentMod = ClampValue(CurrentMod - 1, 0, ListLength(ModNames));

RefreshUI = TRUE;

}

StrafeToggle[CurrentProfile] = Toggle(StrafeMod, StrafeToggle[CurrentProfile]);

FlyingAimToggle[CurrentProfile] = Toggle(FlyingAimMod, FlyingAimToggle[CurrentProfile]);

AimBotToggle[CurrentProfile] = Toggle(AimBotMod, AimBotToggle[CurrentProfile]);

RushStickyToggle[CurrentProfile] = Toggle(RushStickyMod, RushStickyToggle[CurrentProfile]);

SpeedToggle[CurrentProfile] = Toggle(SpeedMod, SpeedToggle[CurrentProfile]);

CrouchShotToggle[CurrentProfile] = Toggle(CrouchShotMod, CrouchShotToggle[CurrentProfile]);

BloomNegatorToggle[CurrentProfile] = Toggle(BloomNegatorMod, BloomNegatorToggle[CurrentProfile]);

NoVibrationToggle[CurrentProfile] = Toggle(NoVibrationMod, NoVibrationToggle[CurrentProfile]);

PreFireToggle[CurrentProfile] = Toggle(PreFireMod, PreFireToggle[CurrentProfile]);

RapidFireToggle[CurrentProfile] = Toggle(RapidFireMod, RapidFireToggle[CurrentProfile]);

iAimToggle[CurrentProfile] = Toggle(iAimMod, iAimToggle[CurrentProfile]);

ExtremeAimToggle[CurrentProfile] = Toggle(ExtremeAimMod, ExtremeAimToggle[CurrentProfile]);

RushAimLockToggle[CurrentProfile] = Toggle(RushAimLockMod, RushAimLockToggle[CurrentProfile]);

AimAbuseToggle[CurrentProfile] = Toggle(AimAbuseMod, AimAbuseToggle[CurrentProfile]);

ApocalypseAimToggle[CurrentProfile] = Toggle(ApocalypseAimMod, ApocalypseAimToggle[CurrentProfile]);

LongRangeToggle[CurrentProfile] = Toggle(LongRangeMod, LongRangeToggle[CurrentProfile]);

RecoilNegatorToggle[CurrentProfile] = Toggle(RecoilNegatorMod, RecoilNegatorToggle[CurrentProfile]);

}

                

if(OpenEditMenu) {

MenuIconHighlights();

