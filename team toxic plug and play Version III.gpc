
// Plug and play script made by mr toxic mr brgv
// Features: Aim Assist, Fast Reload, Anti-Recoil

// Define variables
int ToxicAIM_KILLER    =  TRUE; // Aim Assist
int Strength    =     3; // [1 - 10] =  Aim Assist Strength [1,2,3,4,5] ==> (>> 1 = 5 , 2 = 10 , 3 = 15 , 4 = 20 , 5 = 25 etc <<) [LINEAR USE VALUE 1]

int antiRecoilValue = 17; // Adjust this value for anti-recoil
int fastReload = 100; // Adjust this value for fast reload timing

int cPureAccToggle = TRUE;
int Speed = 12;

int newHold;
int newRest;
int burstHold = 240;
int burstRest = 180;

define DEADZONE_THRESHOLD = 5;  // Adjust this value to fine-tune deadzone removal


// Auto Sprint & Slide Cancel Configuration
int ScriptAutoRun = FALSE; // Put TRUE if you want to sprint all the time 
int Running, Sprinting;
define SprintThreshold = 75;

define Slide_Cancel = TRUE; //FALSE if you dont want slidecancel

define AutoPing = TRUE; // FALSE if you dont want auto ping

int AutoPingDelay = 1800; // ping timer



define RX = PS4_RX;
define RY = PS4_RY;
define LX = PS4_LX;
define LY = PS4_LY;
int rsr, lsr;
int HUE;
int AxisT, AAT;




int RX_val, RY_val, LX_val, LY_val;
int magnitude;


init{cls_oled(0);}
main {
  fastReloadFunction();
  
  	if(counter){
		time += get_rtime();
		if(time >= 500){
			i++;
			stop++;
			time = 0;
			cls_oled(0);
		}
		if(i == 4)i=0;
		image_oled(0,0,1,1,picture[i]);
	}

	if(stop >= 14){
		counter = FALSE;
		cls_oled(0);
	}
  
    RX_val = get_val(PS4_RX);
    RY_val = get_val(PS4_RY);
    LX_val = get_val(PS4_LX);
    LY_val = get_val(PS4_LY);

    
    set_val(PS4_RX, remove_deadzone(RX_val, RY_val));
    set_val(PS4_RY, remove_deadzone(RY_val, RX_val));
    set_val(PS4_LX, remove_deadzone(LX_val, LY_val));
    set_val(PS4_LY, remove_deadzone(LY_val, LX_val));
  
  AA_Mixer();
    rsr = isqrt(pow(get_ival(RX), 2) + pow(get_ival(RY), 2));
    lsr = isqrt(pow(get_ival(LX), 2) + pow(get_ival(LY), 2));
    Running = lsr >= 96 && get_ival(LY) < inv(SprintThreshold);

	
    if(isqrt(pow(get_ival(PS4_RY), 2) + pow(get_ival(PS4_RX), 2)) <= 8)
    {
        set_val(PS4_RY, 0);
        set_val(PS4_RX, 0);
    }

    if (ToxicAIM_KILLER)
    {
        if(get_ival(PS4_L2) || get_ival(PS4_R2))
        {
            ToxicAIM_KILLER();
        }
        else if(!get_ival(PS4_L2) && !get_ival(PS4_R2))
        {
            AAT     = 0;
            AxisT    = 0;
        }
    }
	
	   if (get_val(PS4_R2)) {
        combo_run(recoilCombo);
    }
	
			if(cPureAccToggle)
		{
			if(get_ival(PS4_L2) > 80)
			{
				if(get_ival(PS4_R1) > 10)
				{
					combo_run(cPureAcc);
					newHold =      Speed + random(0, 20);
					newRest =      120 + random(0, 20);
				}
					block(PS4_R1, get_ptime(PS4_L2) + 50);
			}
			else if(get_ival(PS4_L2) < 80 && get_ival(PS4_L2) > 10)
			{
				if(get_ival(PS4_R1) > 10)
				{
					combo_run(cPureAcc);
					newHold = burstHold;
					newRest = burstRest;
				}
					block(PS4_R1, get_ptime(PS4_L2) + 50);
			}
		}
		
  
    rsr = isqrt(pow(get_val(RX), 2) + pow(get_val(RY), 2));
    lsr = isqrt(pow(get_val(LX), 2) + pow(get_val(LY), 2));

    Running = (lsr >= 96 && get_val(LY) < inv(SprintThreshold));

    
    if (ScriptAutoRun) {
        if (Running && !get_val(PS4_L2) && !get_val(PS4_R2)) {
            combo_run(cRun);
        }
    }

    if (Slide_Cancel) {
    if (!get_val(PS4_L2) && !get_val(PS4_R2) && Sprinting && event_release(PS4_CIRCLE)) {
        combo_run(SLIDE_CANCEL);
    } 
    }
    
      if (AutoPing) {
        if (event_press(PS4_R2)) {
            combo_run(Auto_Ping);
        }
    }
		
	
}

combo SLIDE_CANCEL {
    set_val(PS4_CIRCLE, 100);
    wait(30 + random(0, 50));
    set_val(PS4_CIRCLE, 0);
    wait(20);
    set_val(PS4_L3, 100);
}

// **Auto Sprint**
combo cRun {
    set_val(PS4_L3, 100);
    wait(30 + random(20, 40));
    set_val(PS4_L3, 0);
    wait(20 + random(20, 40));
    set_val(PS4_L3, 0);
}


combo cPureAcc {
	set_val(PS4_R2, 100);
	wait(newHold + random(0, 10));
	set_val(PS4_R2, 0);
	wait(newRest + random(0, 10));
}


// Anti-recoil combo
combo recoilCombo {
    set_val(PS4_RY, get_val(PS4_RY) + antiRecoilValue);
}

// Fast reload combo
combo reloadCombo {
    wait(fastReload);
    set_val(PS4_CROSS, 0); // Release reload button
}


// Reload Function
function fastReloadFunction() {
    if (event_press(PS4_CROSS)) { // X for reload
        combo_run(reloadCombo);
    }
}

function ToxicAIM_KILLER() {
    AAT += get_rtime();

    if (!AxisT) 
        Set_Val(PS4_RY, AAT * Strength / 10);

    if (AxisT == 1)  
        Set_Val(PS4_RX, AAT * Strength / 10);

    if (AxisT == 2)  
        Set_Val(PS4_RY, inv(AAT * Strength / 10));

    if (AxisT == 3)
    {
        Set_Val(PS4_RX, inv(AAT * Strength / 10));

        if (AAT > 50)
        {
            AAT    = 0;
            AxisT  = 0;
        }
    }
    else if (AAT > 50)
    {
        AAT       = 0;
        AxisT    += 1;
    }
}


combo Auto_Ping {
    set_val(PS4_UP, 100);
    wait(50);
    set_val(PS4_UP, 0);
    wait(50);
    set_val(PS4_UP, 100);
    wait(50);
    set_val(PS4_UP, 0);
    wait(AutoPingDelay);
}

function Set_Val(Stick, Value) {
    set_val(Stick, clamp(Value * (100 - abs(get_val(Stick))) / 100 + get_val(Stick), -100, 100));
        return;
}

function AA_Mixer() {
    HUE++;

    if(HUE == 255)
        HUE = 0;
        Set_HSB(HUE);
}

function Set_HSB(ColorOne) {
    set_hsb(ColorOne, 100, 100);

    set_val(TRACE_1, ColorOne);
}
function remove_deadzone(int stick_x, int stick_y) {
    magnitude = isqrt(pow(stick_x, 2) + pow(stick_y, 2));

    if (magnitude < DEADZONE_THRESHOLD) {
        return 0;  // Remove small inputs (deadzone)
    } else {
        return (stick_x * (100 - DEADZONE_THRESHOLD)) / 100;  // Scale to retain full range
    }
    
    return 0;  // Ensure function always returns a value
}

