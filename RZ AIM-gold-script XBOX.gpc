define Strafe   = XB1_LX;
define Walk     = XB1_LY;



init{AntiRecoil=get_pvar(SPVAR_3,1,1,1); AR_Ver=get_pvar(SPVAR_11,1,99,antirecoilstrength);AR_Horiz=get_pvar(SPVAR_12,-99,99,0);}

main{
  	if(InstaReset){
 		if(get_val(instareset))
 		combo_run(insta);}
	if(HairTrigger){
		if(get_val(XB1_RT))set_val(XB1_RT,100); 
		if(get_val(XB1_LT))set_val(XB1_LT,100)}
		
	if(PickupMacro){
 		if(get_val(Interact))combo_run(pickupmacro);}
 	if(event_release(Interact)){combo_stop(pickupmacro);} 
  	if(get_val(XB1_LT)){combo_stop(pickupmacro);}

if (BuildTracker) 
{

        
    if (event_press(Build)) 
    {
            
        BuildTrack = !BuildTrack;
    }
    
        if (BuildTrack) 
        {
            
            BuildCount += get_rtime();
            
            if (event_press(Pickaxe) || BuildCount == BuildSyncTime) 
            {
                
                BuildTrack = FALSE;
                BuildCount = 0;
            }
            
            if (get_ival(Roof) || get_ival(Floor) || get_ival(Ramp) || get_ival(Wall) || get_ival(Trap)) 
                
                BuildCount = 0;
        }
    }
    if (!BuildTrack) {
        if (PP10) {
        if (PP11 == 41 || PP11 == 42) {
        		
        		if (get_ival(AdsBtn) || PP13 && get_ival(FireBtn)) {
            		
            		if (PP11 == 41) {
        		
        				if (PP12 >= 10) PP17 = PP12 / 10;
        			
        				else PP17 = 10 / 10;
        			
        				PP18 = 50;
        			}
            	
            		if (PP11 == 42) {
        		
        				if (PP12 >= 10) PP17 = PP12 / 10;
        			
        				else PP17 = 10 / 10;
        			
        				PP18 = 2;
        			}
            		

            	}
            
            	if (!get_ival(AdsBtn) && !get_ival(FireBtn)) {
            
            		PP21 = 0;
            		PP22 = 0;
            	}
        	}       	
        }
    

	if(AntiRecoil){
		if(get_ival(AdsBtn) && get_ival(FireBtn)){
			combo_run(AntiRecoil);}}
	
		if(AutoAim){
			combo_run(StrafeShot)}
		if(AutoAim){
			if(AutoAim && abs(get_ival(Strafe)) <= 35 && abs(get_ival(Walk)) <= 35){
				combo_run(StrafeShot);}
			else{
				combo_stop(StrafeShot);}}
}}

const string one = "     RZ AIM  "
const string two = "FREE GOLD SCRIPT";
const string three = "DISCORD @Rezybot";
const string four = "TikTok @Rezybot_1";


init{
set_rgb(0,0,0)
cls_oled(OLED_WHITE)
print(5,3,OLED_FONT_SMALL,OLED_BLACK,one[0]);
print(5,16,OLED_FONT_SMALL,OLED_BLACK,two[0]);
print(5,29,OLED_FONT_SMALL,OLED_BLACK,three[0]);
print(5,42,OLED_FONT_SMALL,OLED_BLACK,four[0]);}


	
combo StrafeShot{
	set_val(Strafe,-100);
	wait(1);
	set_val(Strafe,100);}
	
combo AntiRecoil{
AntirecoilVertical = get_val(XB1_RY) + AR_Ver;
if(AntirecoilVertical > 100) AntirecoilVertical = 100;
if(abs(get_val(XB1_RY)) < abs(AR_Ver) +  5) set_val(XB1_RY, (AntirecoilVertical));
AntirecoilHorizontal = get_val(XB1_RX) + AR_Horiz;    if(AntirecoilHorizontal > 100) AntirecoilHorizontal = 100;
if(abs(get_val(XB1_RX)) < abs(AR_Horiz)  + 5) set_val(XB1_RX, AntirecoilHorizontal);}

combo pickupmacro {
    set_val(Interact, 100);
	wait(80);
    set_val(Interact, 0);}

combo insta {
	set_val(Edit, 100);
 	wait(40);
	set_val(Reset, 100);
 wait(80)}

